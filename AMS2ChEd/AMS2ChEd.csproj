<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <PackageIcon>rewind_gp_logo_128.png</PackageIcon>
    <ApplicationIcon>StaticFiles\rewind_gp_logo_128.ico</ApplicationIcon>
	  <UpdaterProject>$(SolutionDir)..\AMS2ChEd.Updater\AMS2ChEd.Updater.csproj</UpdaterProject>
	  <UpdaterBinDir>$(SolutionDir)..\AMS2ChEd.Updater\bin\$(Configuration)\net8.0-windows\win-x64\</UpdaterBinDir>
	  <SteamDlcCheckProject>$(SolutionDir)..\AMS2ChEd.SteamDlcCheck\AMS2ChEd.SteamDlcCheck.csproj</SteamDlcCheckProject>
	  <SteamDlcCheckBinDir>$(SolutionDir)..\AMS2ChEd.SteamDlcCheck\bin\$(Configuration)\net8.0-windows\win-x64\</SteamDlcCheckBinDir>
	  <AssemblyVersion>2.2.0.0</AssemblyVersion>
	  <FileVersion>2.2.0.0</FileVersion>
  </PropertyGroup>

<Target Name="BuildAndCopyUpdater" AfterTargets="Build">
	<MSBuild Projects="$(UpdaterProject)" Properties="Configuration=$(Configuration);Platform=AnyCPU" Targets="Build" />

	<ItemGroup>
		<UpdaterFiles Include="$(UpdaterBinDir)**\*.*" />
	</ItemGroup>

	<Copy SourceFiles="@(UpdaterFiles)" DestinationFiles="@(UpdaterFiles->'$(OutputPath)Updater\%(RecursiveDir)%(Filename)%(Extension)')" />
</Target>

<Target Name="BuildAndCopySteamDlcCheck" AfterTargets="Build">
	<MSBuild Projects="$(SteamDlcCheckProject)" Properties="Configuration=$(Configuration);Platform=AnyCPU" Targets="Build" />

	<ItemGroup>
		<SteamDlcCheckFiles Include="$(SteamDlcCheckBinDir)**\*.*" />
	</ItemGroup>

	<Copy SourceFiles="@(SteamDlcCheckFiles)" DestinationFiles="@(SteamDlcCheckFiles->'$(OutputPath)SteamDlcCheck\%(RecursiveDir)%(Filename)%(Extension)')" />
</Target>

<!-- Copies the bundled 1996 spoof season into the build output, unless a different (official) 1996 pack
     is installed there. Done here rather than with CopyToOutputDirectory so that Clean/Rebuild doesn't
     treat the season files as build outputs and delete an installed pack. -->
<Target Name="CopySpoofSeason" AfterTargets="Build">
	<PropertyGroup>
		<InstalledSpoofSeasonFile>$(TargetDir)Seasons\1996\season.json</InstalledSpoofSeasonFile>
		<SpoofSeasonInstalled Condition="Exists('$(InstalledSpoofSeasonFile)')">$([System.IO.File]::ReadAllText('$(InstalledSpoofSeasonFile)').Contains('1996-spoof'))</SpoofSeasonInstalled>
	</PropertyGroup>

	<ItemGroup>
		<SpoofSeasonFiles Include="Seasons\1996\**\*.*" />
	</ItemGroup>

	<Copy Condition="'$(SpoofSeasonInstalled)' != 'False'" SourceFiles="@(SpoofSeasonFiles)" DestinationFiles="@(SpoofSeasonFiles->'$(TargetDir)Seasons\1996\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
</Target>
	
