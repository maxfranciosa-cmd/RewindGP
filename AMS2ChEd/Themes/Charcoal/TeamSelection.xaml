<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Picking a seat as flat charcoal blocks: one block per team on the left, one per seat on the right;
         the chosen team and the chosen seat are filled red. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AMS2ChEd;component/Themes/Charcoal/Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="TeamSelection.WindowBackground" Color="#141414"/>

    <Style x:Key="TeamSelection.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

    <!-- no program window around the content here, only the margin -->
    <Style x:Key="TeamSelection.Frame" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="24"/>
    </Style>

    <Style x:Key="TeamSelection.Root" TargetType="Grid">
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Charcoal.FontBody}"/>
        <Setter Property="TextElement.FontSize" Value="15"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Charcoal.TextBrush}"/>
    </Style>

    <!-- Title bar closed by the red rule -->
    <Style x:Key="TeamSelection.TitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style x:Key="TeamSelection.Title" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TeamSelection.Intro" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,10,0,12"/>
    </Style>

    <Style x:Key="TeamSelection.Body" TargetType="Grid"/>

    <!-- Teams: one block per team -->
    <Style x:Key="TeamSelection.TeamList" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style x:Key="TeamSelection.TeamItem" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Charcoal.FontHeading}"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{StaticResource Charcoal.PanelBrush}" Margin="0,0,0,2" Padding="12,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TeamSelection.TeamListBox" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TeamSelection.TeamItem}"/>
    </Style>

    <!-- the white outline keeps a red team's colour visible on the red block of the chosen team -->
    <Style x:Key="TeamSelection.TeamSwatch" TargetType="Rectangle">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stroke" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TeamSelection.TeamName" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Seats: a title strip with the team name, then one block per seat -->
    <Style x:Key="TeamSelection.SeatsFrame" TargetType="Border">
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

    <Style x:Key="TeamSelection.SeatsFrameInner" TargetType="Border"/>

    <Style x:Key="TeamSelection.SeatsHeader" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="TeamSelection.Seats" TargetType="ItemsControl">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="TeamSelection.Seat" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Block" Background="{StaticResource Charcoal.PanelBrush}" Margin="0,0,2,2" Padding="10">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Block" Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Block" Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TeamSelection.SeatPhoto" TargetType="ContentControl">
        <Setter Property="Background" Value="{StaticResource Charcoal.BackgroundBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TeamSelection.SeatPhotoPlaceholder" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource Charcoal.StripHoverBrush}"/>
    </Style>

    <Style x:Key="TeamSelection.SeatName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="22"/>
    </Style>

    <Style x:Key="TeamSelection.SeatDetail" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="TeamSelection.Buttons" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="TeamSelection.ConfirmButton" TargetType="Button" BasedOn="{StaticResource Charcoal.PrimaryButtonStyle}">
        <Setter Property="Padding" Value="30,10"/>
        <Setter Property="MinWidth" Value="130"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>

    <Style x:Key="TeamSelection.BackButton" TargetType="Button" BasedOn="{StaticResource Charcoal.SecondaryButtonStyle}">
        <Setter Property="Padding" Value="30,10"/>
        <Setter Property="MinWidth" Value="130"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- the seat picked so far, as a muted line under the buttons -->
    <Style x:Key="TeamSelection.StatusBar" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="TeamSelection.StatusText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
</ResourceDictionary>
