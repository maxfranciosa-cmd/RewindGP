<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Choosing the races of a season as flat charcoal blocks: a kept race is lit and marked red, a skipped one is dimmed. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AMS2ChEd;component/Themes/Charcoal/Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="RaceCalendarSelection.WindowBackground" Color="#141414"/>

    <Style x:Key="RaceCalendarSelection.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

    <Style x:Key="RaceCalendarSelection.Root" TargetType="Grid">
        <Setter Property="Margin" Value="24"/>
    </Style>

    <!-- Title bar closed by the red rule -->
    <Style x:Key="RaceCalendarSelection.Header" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="14,8,14,10"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.Season" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="36"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.Title" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- the count sits on a darker block at the end of the title bar -->
    <Style x:Key="RaceCalendarSelection.CountNote" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.BackgroundBrush}"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.CountText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.CountNumber" TargetType="Run">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
    </Style>

    <!-- no grid lines: the gaps between the blocks do that job -->
    <Style x:Key="RaceCalendarSelection.Calendar" TargetType="Border">
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- One race: a lit block with a red rule and a red tick when kept, a dimmed block when skipped -->
    <Style x:Key="RaceCalendarSelection.Day" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="Block"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Charcoal.StripBrush}"
                            BorderThickness="0,0,0,4"
                            Margin="0,0,2,2"
                            Padding="12,9"
                            MinHeight="112">
                        <Grid>
                            <ContentPresenter x:Name="Texts" Opacity="0.4"/>
                            <Border x:Name="Tick"
                                    Background="{StaticResource Charcoal.RedBrush}"
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                <TextBlock Text="✓"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Charcoal.TextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Block" Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
                            <Setter TargetName="Texts" Property="Opacity" Value="1"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- the right margin keeps the round number clear of the tick -->
    <Style x:Key="RaceCalendarSelection.DayRound" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
        <Setter Property="Margin" Value="0,0,28,0"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.DayName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.DayCircuit" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.DayDate" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <!-- Footer -->
    <Style x:Key="RaceCalendarSelection.Footer" TargetType="Grid">
        <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.Warning" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.ConfirmButton" TargetType="Button" BasedOn="{StaticResource Charcoal.PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Padding" Value="30,12"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
