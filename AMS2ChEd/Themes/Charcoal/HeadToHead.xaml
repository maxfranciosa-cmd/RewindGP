<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Teammates compared as flat charcoal blocks: the teams as a list of strips, the selected one in
         red; the races ahead in a dark red block. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AMS2ChEd;component/Themes/Charcoal/Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="HeadToHead.WindowBackground" Color="#141414"/>

    <!-- a team with substitutes, a race with one -->
    <SolidColorBrush x:Key="HeadToHead.AlertBrush" Color="#ee5a70"/>

    <Style x:Key="HeadToHead.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

    <Style x:Key="HeadToHead.Root" TargetType="Grid">
        <Setter Property="Margin" Value="22"/>
    </Style>

    <!-- Teams -->
    <Style x:Key="HeadToHead.TeamListHeader" TargetType="Grid">
        <Setter Property="Margin" Value="4,0,24,10"/>
    </Style>

    <Style x:Key="HeadToHead.TeamListTitle" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style x:Key="HeadToHead.TeamListCaption" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.TeamList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="HeadToHead.TeamItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Strip" Background="{StaticResource Charcoal.StripBrush}" Padding="10,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Strip" Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Strip" Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeadToHead.TeamSwatch" TargetType="Rectangle">
        <Setter Property="Width" Value="4"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="HeadToHead.TeamName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="HeadToHead.TeamNote" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- The team's panel -->
    <Style x:Key="HeadToHead.Sheet" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
        <Setter Property="Padding" Value="26,22"/>
    </Style>

    <Style x:Key="HeadToHead.SheetHeader" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>

    <Style x:Key="HeadToHead.SheetCaption" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
    </Style>

    <Style x:Key="HeadToHead.TeamTitle" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="HeadToHead.SheetNote" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <!-- The two drivers and the score -->
    <Style x:Key="HeadToHead.Comparison" TargetType="Grid"/>

    <Style x:Key="HeadToHead.PhotoLeft" TargetType="Border">
        <Setter Property="Width" Value="112"/>
        <Setter Property="Height" Value="160"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="HeadToHead.PhotoRight" TargetType="Border" BasedOn="{StaticResource HeadToHead.PhotoLeft}"/>

    <Style x:Key="HeadToHead.PhotoPlaceholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.DriverName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="HeadToHead.DriverDetail" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.ScorePanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="20,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.ScoreBoxLeft" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="HeadToHead.ScoreBoxRight" TargetType="Border" BasedOn="{StaticResource HeadToHead.ScoreBoxLeft}">
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style x:Key="HeadToHead.ScoreLabel" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.ScoreValue" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="44"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.Stats" TargetType="Grid">
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="HeadToHead.StatValue" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style x:Key="HeadToHead.StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>

    <Style x:Key="HeadToHead.Message" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>

    <!-- Race by race -->
    <Style x:Key="HeadToHead.SectionHeader" TargetType="Border">
        <Setter Property="Margin" Value="0,22,0,6"/>
    </Style>

    <Style x:Key="HeadToHead.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <Style x:Key="HeadToHead.RaceHeader" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2,0,4"/>
    </Style>

    <Style x:Key="HeadToHead.RaceHeaderAlert" TargetType="TextBlock" BasedOn="{StaticResource HeadToHead.RaceHeader}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
    </Style>

    <Style x:Key="HeadToHead.RaceHeaderUpcoming" TargetType="TextBlock" BasedOn="{StaticResource HeadToHead.RaceHeader}">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style x:Key="HeadToHead.RowName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="HeadToHead.RowNameSubstitute" TargetType="TextBlock" BasedOn="{StaticResource HeadToHead.RowName}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <Style x:Key="HeadToHead.SubstituteCaption" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <Style x:Key="HeadToHead.Cell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0,5"/>
    </Style>

    <Style x:Key="HeadToHead.CellAhead" TargetType="Border" BasedOn="{StaticResource HeadToHead.Cell}">
        <Setter Property="Background" Value="#5a1a26"/>
    </Style>

    <Style x:Key="HeadToHead.CellText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.CellTextMuted" TargetType="TextBlock" BasedOn="{StaticResource HeadToHead.CellText}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <Style x:Key="HeadToHead.AbsentStamp" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="0,4"/>
    </Style>

    <Style x:Key="HeadToHead.AbsentText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="HeadToHead.Legend" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
</ResourceDictionary>
