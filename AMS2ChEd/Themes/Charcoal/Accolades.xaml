<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A driver's or a team's profile as flat charcoal blocks. Shared by DriverAccoladesWindow and
         ConstructorAccoladesWindow. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AMS2ChEd;component/Themes/Charcoal/Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Accolades.WindowBackground" Color="#141414"/>

    <Style x:Key="Accolades.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

    <Style x:Key="Accolades.Root" TargetType="Grid">
        <Setter Property="Margin" Value="24"/>
    </Style>

    <!-- Title bar closed by the red rule -->
    <Style x:Key="Accolades.Tab" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Accolades.TabText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Margin" Value="14,8"/>
    </Style>

    <!-- team colour as a bar at the start of the title bar -->
    <Style x:Key="Accolades.TeamColorStrip" TargetType="Border">
        <Setter Property="Width" Value="8"/>
    </Style>

    <Style x:Key="Accolades.TeamTabText" TargetType="TextBlock" BasedOn="{StaticResource Accolades.TabText}"/>

    <Style x:Key="Accolades.Sheet" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Profile -->
    <Style x:Key="Accolades.Caption" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Accolades.Name" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Accolades.Detail" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="Accolades.Photo" TargetType="Border">
        <Setter Property="Width" Value="98"/>
        <Setter Property="Height" Value="140"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="Accolades.PhotoPlaceholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Totals: one block per figure, the number at the end -->
    <Style x:Key="Accolades.Totals" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="Accolades.TotalRow" TargetType="DockPanel">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="Accolades.TotalLabel" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>

    <Style x:Key="Accolades.TotalNumber" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="DockPanel.Dock" Value="Right"/>
        <Setter Property="Margin" Value="8,3,12,3"/>
    </Style>

    <!-- no dotted leader: the block itself ties the label to its number -->
    <Style x:Key="Accolades.Leader" TargetType="Line">
        <Setter Property="Visibility" Value="Hidden"/>
    </Style>

    <!-- Section headings -->
    <Style x:Key="Accolades.SectionHeader" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,6"/>
    </Style>

    <Style x:Key="Accolades.SeasonsHeader" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Accolades.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <!-- A championship year on a red block -->
    <Style x:Key="Accolades.ChampionshipBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <Style x:Key="Accolades.ChampionshipBadgeText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="19"/>
    </Style>

    <Style x:Key="Accolades.Empty" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <!-- Previous seasons table: a header strip, then one block per season -->
    <Style x:Key="Accolades.ColumnHeaders" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="Accolades.ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <Style x:Key="Accolades.SeasonRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="0,4"/>
    </Style>

    <Style x:Key="Accolades.Cell" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Accolades.DriverCell" TargetType="TextBlock" BasedOn="{StaticResource Accolades.Cell}"/>
</ResourceDictionary>
