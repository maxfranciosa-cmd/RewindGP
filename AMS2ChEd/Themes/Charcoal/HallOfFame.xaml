<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- The all-time records as flat charcoal blocks: a title bar and the two tables. A driver who has
         retired is written softer, one who belongs to the past softer still; the player's own row
         carries the red rule. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AMS2ChEd;component/Themes/Charcoal/Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="HallOfFame.WindowBackground" Color="#141414"/>

    <!-- size of the table text, and its size on a wide window; the title is drawn larger in proportion -->
    <sys:Double x:Key="HallOfFame.FontSize">20</sys:Double>
    <sys:Double x:Key="HallOfFame.WideFontSize">26</sys:Double>

    <Style x:Key="HallOfFame.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

    <!-- the text styles below leave the size alone, so the whole page follows the size set on the root -->
    <Style x:Key="HallOfFame.Root" TargetType="Grid">
        <Setter Property="Margin" Value="24"/>
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Charcoal.FontHeading}"/>
        <Setter Property="TextElement.FontStretch" Value="Condensed"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Charcoal.TextBrush}"/>
    </Style>

    <!-- no page number here -->
    <Style x:Key="HallOfFame.PageHeader" TargetType="Grid">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="HallOfFame.PageHeaderText" TargetType="TextBlock"/>

    <Style x:Key="HallOfFame.PageNumber" TargetType="TextBlock"/>

    <!-- Title bar closed by the red rule -->
    <Style x:Key="HallOfFame.TitleBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="HallOfFame.Title" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Legend: each word written the way its drivers are -->
    <Style x:Key="HallOfFame.Legend" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="HallOfFame.LegendActive" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
    </Style>

    <Style x:Key="HallOfFame.LegendRetired" TargetType="TextBlock" BasedOn="{StaticResource HallOfFame.LegendActive}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
    </Style>

    <Style x:Key="HallOfFame.LegendHistoric" TargetType="TextBlock" BasedOn="{StaticResource HallOfFame.LegendActive}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <!-- The two tables: a title strip, then one block per row -->
    <Style x:Key="HallOfFame.SectionHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="HallOfFame.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- the player's own row is closed by the red rule -->
    <Style x:Key="HallOfFame.Row" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,4,0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- rank in a white box at the start of the row -->
    <Style x:Key="HallOfFame.RowRank" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.BackgroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="HallOfFame.RowName" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Retired">
                <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Historic">
                <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HallOfFame.RowValue" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="HallOfFame.RowYears" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Charcoal.FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,12,6"/>
    </Style>

    <!-- shown instead of a table when nobody has won anything yet -->
    <Style x:Key="HallOfFame.Empty" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Charcoal.FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8"/>
    </Style>
</ResourceDictionary>
