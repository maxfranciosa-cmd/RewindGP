<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Season overview as flat charcoal blocks: the driver card, the next race and the standings tables. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AMS2ChEd;component/Themes/Charcoal/Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="SeasonOverview.WindowBackground" Color="#141414"/>
    <SolidColorBrush x:Key="SeasonOverview.HighlightBrush" Color="#c41e3a"/>

    <Style x:Key="SeasonOverview.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

    <Style x:Key="SeasonOverview.Root" TargetType="Grid">
        <Setter Property="Margin" Value="24"/>
    </Style>

    <!-- Driver card -->
    <Style x:Key="SeasonOverview.PassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
    </Style>

    <!-- the season sits on a bar closed by the red rule -->
    <Style x:Key="SeasonOverview.SeasonBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style x:Key="SeasonOverview.SeasonBannerText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- the portrait runs the full width of the card -->
    <Style x:Key="SeasonOverview.Photo" TargetType="Border">
        <Setter Property="Width" Value="182"/>
        <Setter Property="Height" Value="260"/>
        <Setter Property="Margin" Value="0,18,0,18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="SeasonOverview.PhotoPlaceholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- name on a red block under the portrait -->
    <Style x:Key="SeasonOverview.PlayerName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="Padding" Value="14,6"/>
    </Style>

    <Style x:Key="SeasonOverview.PassRows" TargetType="StackPanel">
        <Setter Property="Margin" Value="14,12,14,2"/>
    </Style>

    <Style x:Key="SeasonOverview.PassRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SeasonOverview.PassLabel" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="SeasonOverview.PassValue" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style x:Key="SeasonOverview.EditButton" TargetType="Button" BasedOn="{StaticResource Charcoal.LinkButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="14,0,14,8"/>
    </Style>

    <Style x:Key="SeasonOverview.InstallPackageButton" TargetType="Button" BasedOn="{StaticResource Charcoal.PrimaryButtonStyle}">
        <Setter Property="Margin" Value="0,20,0,0"/>
    </Style>

    <Style x:Key="SeasonOverview.ImprovementPackagesButton" TargetType="Button" BasedOn="{StaticResource Charcoal.SecondaryButtonStyle}">
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="SeasonOverview.HistoricalStandingsButton" TargetType="Button" BasedOn="{StaticResource Charcoal.SecondaryButtonStyle}">
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Next race -->
    <Style x:Key="SeasonOverview.NextRaceCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
    </Style>

    <Style x:Key="SeasonOverview.NextRaceInfo" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="20,14"/>
    </Style>

    <Style x:Key="SeasonOverview.NextRaceLabel" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
    </Style>

    <Style x:Key="SeasonOverview.NextRaceName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,4"/>
    </Style>

    <Style x:Key="SeasonOverview.NextRaceDetails" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
    </Style>

    <!-- no ticket stub here: the action is a full-height block at the end of the card -->
    <Style x:Key="SeasonOverview.Perforation" TargetType="Line">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <Style x:Key="SeasonOverview.ProceedButton" TargetType="Button" BasedOn="{StaticResource Charcoal.PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Padding" Value="30,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- Standings and calendar tables: a title strip, then one block per row -->
    <Style x:Key="SeasonOverview.SheetCard" TargetType="Border"/>

    <Style x:Key="SeasonOverview.SheetHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="SeasonOverview.SheetTitle" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,10,0,8"/>
    </Style>

    <!-- the link to the grid view sits under the title, inside the strip: at the window's minimum
         width the two do not fit side by side -->
    <Style x:Key="SeasonOverview.SheetLinkButton" TargetType="Button" BasedOn="{StaticResource Charcoal.LinkButtonStyle}">
        <Setter Property="Grid.Row" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,-8,0,4"/>
    </Style>

    <!-- the player's own row is filled red -->
    <Style x:Key="SeasonOverview.SheetRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="SeasonOverview.CalendarRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- position in a white box at the start of the row -->
    <Style x:Key="SeasonOverview.RowPosition" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.BackgroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,7"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="SeasonOverview.NumberBadge" TargetType="Border">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SeasonOverview.NumberBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Charcoal.FontHeading}"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- team colour as a bar the height of the row -->
    <Style x:Key="SeasonOverview.TeamSwatch" TargetType="Rectangle">
        <Setter Property="Width" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="SeasonOverview.RowName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SeasonOverview.RowPoints" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="SeasonOverview.RowDetail" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="Margin" Value="8,0,12,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
