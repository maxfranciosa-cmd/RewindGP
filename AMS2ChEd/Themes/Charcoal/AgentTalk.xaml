<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The talk with the agent as a messaging app: the agent's replies come in on the left, the player's
         lines go out in red on the right, and the lines the player can send next wait at the foot as
         reply buttons. No agent on screen, so nothing moves. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AMS2ChEd;component/Themes/Charcoal/Base.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="AgentTalk.WindowBackground" Color="#141414"/>

    <Style x:Key="AgentTalk.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

    <Style x:Key="AgentTalk.Root" TargetType="Grid">
        <Setter Property="Margin" Value="22"/>
        <Setter Property="TextElement.FontFamily" Value="{StaticResource Charcoal.FontBody}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Charcoal.TextBrush}"/>
    </Style>

    <Style x:Key="AgentTalk.Page" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
        <Setter Property="Padding" Value="26,20"/>
    </Style>

    <!-- The contact -->
    <Style x:Key="AgentTalk.Header" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,4"/>
        <Setter Property="Padding" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="AgentTalk.Avatar" TargetType="Border">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <Style x:Key="AgentTalk.AvatarIcon" TargetType="Path">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>

    <Style x:Key="AgentTalk.ContactName" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
        <Setter Property="FontSize" Value="26"/>
    </Style>

    <Style x:Key="AgentTalk.ContactDetail" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
    </Style>

    <!-- what the conversation is about, as the note an app shows at the top of a chat -->
    <Style x:Key="AgentTalk.Notice" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="MaxWidth" Value="680"/>
        <Setter Property="Margin" Value="0,16,0,4"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
    </Style>

    <Style x:Key="AgentTalk.Intro" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AgentTalk.Caution" TargetType="TextBlock" BasedOn="{StaticResource AgentTalk.Intro}">
        <Setter Property="Foreground" Value="{StaticResource Charcoal.AccentTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- the agent's office belongs to the retro look -->
    <Style x:Key="AgentTalk.Stage" TargetType="Grid">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="AgentTalk.Backdrop" TargetType="Control"/>
    <Style x:Key="AgentTalk.Agent" TargetType="Image"/>
    <Style x:Key="AgentTalk.Desk" TargetType="Control"/>
    <Style x:Key="AgentTalk.Bubble" TargetType="ContentControl"/>
    <Style x:Key="AgentTalk.BubbleText" TargetType="TextBlock"/>

    <!-- The conversation -->
    <Style x:Key="AgentTalk.Thread" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Padding" Value="0,14"/>
    </Style>

    <Style x:Key="AgentTalk.Message" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="CornerRadius" Value="18,18,18,4"/>
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="CornerRadius" Value="18,18,4,18"/>
                <Setter Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AgentTalk.MessageText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- The replies the player can send -->
    <Style x:Key="AgentTalk.OptionsBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
        <Setter Property="Padding" Value="14,12,6,4"/>
        <Setter Property="MaxHeight" Value="220"/>
    </Style>

    <Style x:Key="AgentTalk.Options" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AgentTalk.Option" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Charcoal.FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Charcoal.TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.AccentTextBrush}"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="16,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
