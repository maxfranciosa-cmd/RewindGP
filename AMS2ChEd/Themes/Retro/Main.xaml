<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The main menu as a magazine cover: the masthead on top, the cover lines are the menu, and the forms
         are printed on a card laid over the cover. Builds on the shared paper/stamp resources of RetroTheme.xaml. -->

    <!-- the red cover (same gradient as CoverBrush) -->
    <LinearGradientBrush x:Key="Main.WindowBackground" StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Color="#e8372c" Offset="0"/>
        <GradientStop Color="#c81f2a" Offset="0.45"/>
        <GradientStop Color="#7c1220" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Main.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

    <Style x:Key="Main.Root" TargetType="Grid">
        <Setter Property="Margin" Value="36,22,36,30"/>
    </Style>

    <!-- Masthead -->
    <Style x:Key="Main.Masthead" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>

    <Style x:Key="Main.MastheadBox" TargetType="Viewbox">
        <Setter Property="MaxHeight" Value="230"/>
    </Style>

    <Style x:Key="Main.MastheadTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="150"/>
        <Setter Property="Margin" Value="0,0,12,8"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#111111" BlurRadius="0" ShadowDepth="7" Direction="315" Opacity="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Main.MastheadWord" TargetType="Run">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="Main.MastheadAccent" TargetType="Run">
        <Setter Property="Foreground" Value="#ffe14a"/>
    </Style>

    <Style x:Key="Main.Logo" TargetType="Image">
        <Setter Property="Height" Value="90"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="20,6,0,0"/>
    </Style>

    <!-- A cover line of the magazine: each one is a main menu entry -->
    <Style x:Key="Main.MenuLine" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CoverYellowBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Continue: the top cover line, in white, with the latest save described under it -->
    <Style x:Key="Main.ContinuePanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="Main.ContinueButton" TargetType="Button" BasedOn="{StaticResource Main.MenuLine}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="Main.ContinueDescription" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrint}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <!-- The ways to start a new game, boxed together like a feature panel on the cover;
         the title sits on the top edge of the box, like a section tag -->
    <Style x:Key="Main.NewGameGroup" TargetType="Grid">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="Main.NewGameBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource CoverYellowBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Margin" Value="0,15,0,0"/>
        <Setter Property="Padding" Value="6,22,16,4"/>
    </Style>

    <Style x:Key="Main.NewGameTag" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CoverYellowBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="14,0,0,0"/>
        <Setter Property="Padding" Value="10,1,10,3"/>
    </Style>

    <Style x:Key="Main.NewGameTagText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#111111"/>
    </Style>

    <Style x:Key="Main.NewGameLine" TargetType="Button" BasedOn="{StaticResource Main.MenuLine}">
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- Install a season pack: the round sticker on the cover -->
    <Style x:Key="Main.InstallSeasonButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CoverYellowBrush}"/>
        <Setter Property="Foreground" Value="#111111"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="Width" Value="156"/>
        <Setter Property="Height" Value="156"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,6,30,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{TemplateBinding Background}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="112">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Forms are printed on a card laid over the cover -->
    <Style x:Key="Main.FormCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Main.FormPanel" TargetType="StackPanel">
        <Setter Property="Margin" Value="24"/>
    </Style>

    <Style x:Key="Main.FormLabel" TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontTyped}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- a label that opens a new group of fields, set apart from the field above it -->
    <Style x:Key="Main.FormLabelSpaced" TargetType="Label" BasedOn="{StaticResource Main.FormLabel}">
        <Setter Property="Margin" Value="0,10,0,5"/>
    </Style>

    <Style x:Key="Main.TextBox" TargetType="TextBox" BasedOn="{StaticResource PaperTextBoxStyle}"/>

    <!-- a text box in a row of several, where the row gives the spacing -->
    <Style x:Key="Main.CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource Main.TextBox}">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="Main.ComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontFamily" Value="{StaticResource FontTyped}"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                    Background="White"
                                    BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="2"
                                    Focusable="False"
                                    IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="Border"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"/>
                                        <Path x:Name="Arrow"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            Data="M 0 0 L 4 4 L 8 0 Z"
                                            Fill="#1b1b1b"/>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                        IsHitTestVisible="False"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        Margin="7,3,23,3"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1b1b1b"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Popup x:Name="Popup"
                             Placement="Bottom"
                             IsOpen="{TemplateBinding IsDropDownOpen}"
                             AllowsTransparency="True"
                             Focusable="False"
                             PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                SnapsToDevicePixels="True"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="200">
                                <Border x:Name="DropDownBorder"
                                      Background="White"
                                      BorderBrush="{StaticResource InkBrush}"
                                      BorderThickness="2"/>
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1b1b1b"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0">
                                <ContentPresenter Margin="7,4,5,4"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource HighlighterBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource HighlighterBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <!-- Main action on a form (subscription-card style) -->
    <Style x:Key="Main.FormPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StampRedBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="0,20,0,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#111111"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- a main action directly under another one -->
    <Style x:Key="Main.FormStackedButton" TargetType="Button" BasedOn="{StaticResource Main.FormPrimaryButton}">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Main.FormBackButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PostItBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A driver taken from another season: a framed photo with the name beside it -->
    <Style x:Key="Main.ImportedDriver" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,10,0,15"/>
    </Style>

    <Style x:Key="Main.ImportedPhoto" TargetType="Border">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="122"/>
        <Setter Property="Background" Value="{StaticResource PhotoBackBrush}"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Main.ImportedPhotoPlaceholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="Foreground" Value="#5e666e"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Main.ImportedName" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Main.ImportedInfo" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Helmet designs: a white box with one swatch per design, the chosen one outlined in red -->
    <Style x:Key="Main.HelmetBox" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
        <Setter Property="Height" Value="150"/>
    </Style>

    <Style x:Key="Main.HelmetItem" TargetType="Border">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#d9d5c8"/>
        <Setter Property="Background" Value="#f4f1e6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#8a8679"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource StampRedBrush}"/>
                <Setter Property="Background" Value="White"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Right column: the cover photo, with the cover story of the latest save below it -->
    <Style x:Key="Main.VisualPanel" TargetType="Grid">
        <Setter Property="Margin" Value="30,0,0,0"/>
    </Style>

    <!-- the white photo frame only shows when there is a picture to frame (WelcomeImage is the picture inside it) -->
    <Style x:Key="Main.CoverPhoto" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActualHeight, ElementName=WelcomeImage}" Value="0">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Main.CoverStory" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <Style x:Key="Main.CoverHeadline" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CoverYellowBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="LineHeight" Value="31"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Main.CoverSubline" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrint}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- Reputation picture shown while creating a driver, framed like the cover photo -->
    <Style x:Key="Main.ReputationPhoto" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="3" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Main.ReputationName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CoverYellowBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="Main.ReputationText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontPrint}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>
</ResourceDictionary>
