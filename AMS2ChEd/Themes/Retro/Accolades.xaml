<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A driver's or a team's file: a manila folder with a typed sheet. Shared by DriverAccoladesWindow and
         ConstructorAccoladesWindow. Builds on the shared paper/stamp resources of RetroTheme.xaml. -->

    <SolidColorBrush x:Key="Accolades.WindowBackground" Color="#d6b377"/>

    <Style x:Key="Accolades.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

    <Style x:Key="Accolades.Root" TargetType="Grid">
        <Setter Property="Margin" Value="18,10,18,18"/>
    </Style>

    <!-- Folder tab -->
    <Style x:Key="Accolades.Tab" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ManilaLightBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
    </Style>

    <Style x:Key="Accolades.TabText" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="Margin" Value="18,8,18,10"/>
    </Style>

    <!-- the team's tab is marked with a strip in the team colour -->
    <Style x:Key="Accolades.TeamColorStrip" TargetType="Border">
        <Setter Property="Width" Value="12"/>
        <Setter Property="CornerRadius" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="Accolades.TeamTabText" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="Margin" Value="14,8,18,10"/>
    </Style>

    <Style x:Key="Accolades.Sheet" TargetType="Border" BasedOn="{StaticResource PaperCardStyle}">
        <Setter Property="Padding" Value="22"/>
    </Style>

    <!-- Profile -->
    <Style x:Key="Accolades.Caption" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="Accolades.Name" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Accolades.Detail" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- the photo is attached to the sheet with a white edge -->
    <Style x:Key="Accolades.Photo" TargetType="Border">
        <Setter Property="Width" Value="112"/>
        <Setter Property="Height" Value="142"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
        <Setter Property="Background" Value="{StaticResource PhotoBackBrush}"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="5"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Accolades.PhotoPlaceholder" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="Foreground" Value="#5e666e"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Totals: a label, a dotted leader and the number -->
    <Style x:Key="Accolades.Totals" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style x:Key="Accolades.TotalRow" TargetType="DockPanel"/>

    <Style x:Key="Accolades.TotalLabel" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Accolades.TotalNumber" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="DockPanel.Dock" Value="Right"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="Accolades.Leader" TargetType="Line">
        <Setter Property="X2" Value="1"/>
        <Setter Property="Stretch" Value="Fill"/>
        <Setter Property="Stroke" Value="{StaticResource InkFaintBrush}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeDashArray" Value="1 2"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="8,0,0,7"/>
    </Style>

    <!-- Section headings, underlined in ink -->
    <Style x:Key="Accolades.SectionHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Margin" Value="0,16,0,10"/>
    </Style>

    <Style x:Key="Accolades.SeasonsHeader" TargetType="Border" BasedOn="{StaticResource Accolades.SectionHeader}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Accolades.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- A championship year, rubber-stamped on the sheet -->
    <Style x:Key="Accolades.ChampionshipBadge" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource StampGreenBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Margin" Value="0,0,10,8"/>
        <Setter Property="Padding" Value="10,3,10,3"/>
    </Style>

    <Style x:Key="Accolades.ChampionshipBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="Foreground" Value="{StaticResource StampGreenBrush}"/>
    </Style>

    <!-- the dash shown when there is nothing to list -->
    <Style x:Key="Accolades.Empty" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
    </Style>

    <!-- Previous seasons table -->
    <Style x:Key="Accolades.ColumnHeaders" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Accolades.ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Accolades.SeasonRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkFaintBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,6"/>
    </Style>

    <Style x:Key="Accolades.Cell" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- the driver's table has two more columns, so its type is a touch smaller -->
    <Style x:Key="Accolades.DriverCell" TargetType="TextBlock" BasedOn="{StaticResource Accolades.Cell}">
        <Setter Property="FontSize" Value="17"/>
    </Style>
</ResourceDictionary>
