<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The driver market as a transfer-news page pinned on the board: the masthead, the player on the left
         with their own team's verdict on a sticky note, the seats on the right, each rubber-stamped with the
         player's chance. Builds on the shared paper/stamp/sticky-note resources of RetroTheme.xaml. -->

    <SolidColorBrush x:Key="MarketOutlook.WindowBackground" Color="#b08a5e"/>

    <!-- the stamp of each chance band -->
    <SolidColorBrush x:Key="MarketOutlook.VeryLikelyBrush" Color="#1f6f3a"/>
    <SolidColorBrush x:Key="MarketOutlook.LikelyBrush" Color="#3f8a52"/>
    <SolidColorBrush x:Key="MarketOutlook.PossibleBrush" Color="#1d4ed8"/>
    <SolidColorBrush x:Key="MarketOutlook.LongShotBrush" Color="#c1121f"/>

    <Style x:Key="MarketOutlook.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

    <Style x:Key="MarketOutlook.Root" TargetType="Grid">
        <Setter Property="Margin" Value="24,22"/>
    </Style>

    <Style x:Key="MarketOutlook.Page" TargetType="Border" BasedOn="{StaticResource PaperCardStyle}">
        <Setter Property="Padding" Value="30,22"/>
    </Style>

    <!-- Masthead -->
    <Style x:Key="MarketOutlook.Header" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,3"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="MarketOutlook.Kicker" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MarketOutlook.Headline" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MarketOutlook.HeaderNote" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MaxWidth" Value="250"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="20,0,0,4"/>
    </Style>

    <!-- The player -->
    <Style x:Key="MarketOutlook.LeftColumn" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkFaintBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="0,16,26,6"/>
    </Style>

    <Style x:Key="MarketOutlook.SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="MarketOutlook.DriverName" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MarketOutlook.DriverDetail" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MarketOutlook.Figures" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <Style x:Key="MarketOutlook.Figure" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,26,0"/>
    </Style>

    <Style x:Key="MarketOutlook.FigureLabel" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="MarketOutlook.FigureValue" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="34"/>
    </Style>

    <Style x:Key="MarketOutlook.FigureText" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="170"/>
    </Style>

    <!-- the player's own team's verdict, on a sticky note -->
    <Style x:Key="MarketOutlook.PostIt" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PostItBrush}"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="4,20,4,4"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="-1.5"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MarketOutlook.PostItTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHand}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MarketOutlook.PostItText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHand}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- The seats -->
    <Style x:Key="MarketOutlook.RightColumn" TargetType="Grid">
        <Setter Property="Margin" Value="28,16,0,0"/>
    </Style>

    <Style x:Key="MarketOutlook.ListHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="0,0,0,3"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="MarketOutlook.ListTitle" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="MarketOutlook.ListCaption" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="MarketOutlook.SeatRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkFaintBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,8"/>
    </Style>

    <Style x:Key="MarketOutlook.TeamSwatch" TargetType="Rectangle">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="MarketOutlook.SeatTeam" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="MarketOutlook.SeatDetail" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- the chance, rubber-stamped in the band's colour (set per seat) -->
    <Style x:Key="MarketOutlook.Stamp" TargetType="Border">
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="6,0,18,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="-2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MarketOutlook.StampText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MarketOutlook.Reason" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MarketOutlook.Message" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

    <!-- The best applications, boxed at the foot of the page -->
    <Style x:Key="MarketOutlook.BestBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,14,0,0"/>
    </Style>

    <Style x:Key="MarketOutlook.BestLabel" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="MarketOutlook.BestText" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MarketOutlook.BestStamp" TargetType="Border">
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Margin" Value="16,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="-3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MarketOutlook.BestStampText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>
</ResourceDictionary>
