<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The talk with the agent as a DOS VGA point-and-click scene: the agent behind his desk at night,
         his latest reply in a speech bubble ending in a blinking cursor, the player's lines below in the
         adventure-game colours. The agent's sprite frames come from the window (AgentSprite), drawn
         here without smoothing. Builds on the shared teletext resources of RetroTheme.xaml. -->

    <SolidColorBrush x:Key="AgentTalk.WindowBackground" Color="#000000"/>

    <SolidColorBrush x:Key="AgentTalk.FrameBrush" Color="#aaaaaa"/>
    <SolidColorBrush x:Key="AgentTalk.WallBrush" Color="#2a1d48"/>
    <SolidColorBrush x:Key="AgentTalk.WoodBrush" Color="#8a5a2a"/>
    <SolidColorBrush x:Key="AgentTalk.NightBrush" Color="#000055"/>
    <SolidColorBrush x:Key="AgentTalk.BuildingBrush" Color="#15153a"/>
    <SolidColorBrush x:Key="AgentTalk.BuildingLightBrush" Color="#1e1e50"/>
    <SolidColorBrush x:Key="AgentTalk.LitWindowBrush" Color="#ffff55"/>
    <SolidColorBrush x:Key="AgentTalk.OptionBrush" Color="#aa55ff"/>
    <SolidColorBrush x:Key="AgentTalk.OptionHoverBrush" Color="#ffff55"/>

    <Style x:Key="AgentTalk.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource TeletextScrollBarStyle}"/>

    <Style x:Key="AgentTalk.Root" TargetType="Grid">
        <Setter Property="Margin" Value="24"/>
        <Setter Property="TextElement.FontFamily" Value="{StaticResource FontScreen}"/>
    </Style>

    <Style x:Key="AgentTalk.Page" TargetType="Border"/>

    <!-- the contact header belongs to the messaging look -->
    <Style x:Key="AgentTalk.Header" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="AgentTalk.Avatar" TargetType="Border"/>
    <Style x:Key="AgentTalk.AvatarIcon" TargetType="Path"/>
    <Style x:Key="AgentTalk.ContactName" TargetType="TextBlock"/>
    <Style x:Key="AgentTalk.ContactDetail" TargetType="TextBlock"/>

    <!-- what the conversation is about, as screen text -->
    <Style x:Key="AgentTalk.Notice" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="AgentTalk.Intro" TargetType="TextBlock">
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="Foreground" Value="{StaticResource TeletextCyanBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AgentTalk.Caution" TargetType="TextBlock" BasedOn="{StaticResource AgentTalk.Intro}">
        <Setter Property="Foreground" Value="{StaticResource TeletextYellowBrush}"/>
    </Style>

    <!-- The scene -->
    <Style x:Key="AgentTalk.Stage" TargetType="Grid">
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- the office wall and the window onto the city at night, framed like the game's viewport -->
    <Style x:Key="AgentTalk.Backdrop" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border BorderBrush="{StaticResource AgentTalk.FrameBrush}" BorderThickness="4" Background="{StaticResource AgentTalk.WallBrush}">
                        <Grid>
                            <Border VerticalAlignment="Bottom" Height="8" Margin="0,0,0,164" Background="#5a3a1a"/>
                            <Border VerticalAlignment="Bottom" Height="70" Margin="0,0,0,94" Background="#3a2a14"/>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,32,0,0" Width="344" Height="220"
                                    BorderBrush="{StaticResource AgentTalk.WoodBrush}" BorderThickness="8" Background="{StaticResource AgentTalk.NightBrush}">
                                <Canvas ClipToBounds="True">
                                    <Rectangle Canvas.Left="30" Canvas.Top="18" Width="4" Height="4" Fill="White"/>
                                    <Rectangle Canvas.Left="120" Canvas.Top="34" Width="4" Height="4" Fill="White"/>
                                    <Rectangle Canvas.Left="210" Canvas.Top="14" Width="4" Height="4" Fill="White"/>
                                    <Rectangle Canvas.Left="290" Canvas.Top="40" Width="4" Height="4" Fill="White"/>
                                    <Rectangle Canvas.Left="70" Canvas.Top="60" Width="4" Height="4" Fill="#aaaaaa"/>
                                    <Rectangle Canvas.Left="250" Canvas.Top="70" Width="4" Height="4" Fill="#aaaaaa"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="120" Width="60" Height="100" Fill="{StaticResource AgentTalk.BuildingBrush}"/>
                                    <Rectangle Canvas.Left="64" Canvas.Top="90" Width="48" Height="130" Fill="{StaticResource AgentTalk.BuildingLightBrush}"/>
                                    <Rectangle Canvas.Left="116" Canvas.Top="136" Width="70" Height="84" Fill="{StaticResource AgentTalk.BuildingBrush}"/>
                                    <Rectangle Canvas.Left="190" Canvas.Top="76" Width="40" Height="144" Fill="{StaticResource AgentTalk.BuildingLightBrush}"/>
                                    <Rectangle Canvas.Left="234" Canvas.Top="124" Width="94" Height="96" Fill="{StaticResource AgentTalk.BuildingBrush}"/>
                                    <Rectangle Canvas.Left="76" Canvas.Top="104" Width="8" Height="8" Fill="{StaticResource AgentTalk.LitWindowBrush}"/>
                                    <Rectangle Canvas.Left="92" Canvas.Top="128" Width="8" Height="8" Fill="{StaticResource AgentTalk.LitWindowBrush}"/>
                                    <Rectangle Canvas.Left="200" Canvas.Top="96" Width="8" Height="8" Fill="{StaticResource AgentTalk.LitWindowBrush}"/>
                                    <Rectangle Canvas.Left="214" Canvas.Top="140" Width="8" Height="8" Fill="{StaticResource AgentTalk.LitWindowBrush}"/>
                                    <Rectangle Canvas.Left="130" Canvas.Top="150" Width="8" Height="8" Fill="{StaticResource AgentTalk.LitWindowBrush}"/>
                                    <Rectangle Canvas.Left="260" Canvas.Top="140" Width="8" Height="8" Fill="{StaticResource AgentTalk.LitWindowBrush}"/>
                                    <Rectangle Canvas.Left="160" Canvas.Top="0" Width="8" Height="220" Fill="{StaticResource AgentTalk.WoodBrush}"/>
                                </Canvas>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the agent, eight screen pixels to a sprite pixel, his lower jacket behind the desk -->
    <Style x:Key="AgentTalk.Agent" TargetType="Image">
        <Setter Property="Width" Value="256"/>
        <Setter Property="Height" Value="272"/>
        <Setter Property="Stretch" Value="Fill"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="88,0,0,58"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
    </Style>

    <!-- the desk, with a phone and a pile of papers -->
    <Style x:Key="AgentTalk.Desk" TargetType="Control">
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid Height="98" Margin="4,0,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#b06a2c"/>
                        <Border Grid.Row="1" Background="#7a4418"/>
                        <Canvas Grid.Row="0" ClipToBounds="False">
                            <Rectangle Canvas.Left="372" Canvas.Top="-16" Width="72" Height="16" Fill="Black"/>
                            <Rectangle Canvas.Left="380" Canvas.Top="-24" Width="56" Height="8" Fill="Black"/>
                            <Rectangle Canvas.Left="476" Canvas.Top="-18" Width="84" Height="6" Fill="#aaaaaa"/>
                            <Rectangle Canvas.Left="470" Canvas.Top="-12" Width="90" Height="12" Fill="White"/>
                            <Rectangle Canvas.Left="380" Canvas.Top="12" Width="8" Height="86" Fill="#5a3010"/>
                            <Rectangle Canvas.Left="780" Canvas.Top="12" Width="8" Height="86" Fill="#5a3010"/>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the speech bubble: white with a hard black shadow, its tail stepping down to the agent's mouth -->
    <Style x:Key="AgentTalk.Bubble" TargetType="ContentControl">
        <Setter Property="Margin" Value="428,28,40,124"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="Black" Margin="8,8,-8,-8"/>
                        <Border Background="White" BorderBrush="Black" BorderThickness="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,12">
                                <ContentPresenter/>
                            </ScrollViewer>
                        </Border>
                        <Canvas VerticalAlignment="Bottom" HorizontalAlignment="Left" ClipToBounds="False">
                            <Border Canvas.Left="-20" Canvas.Top="-104" Width="20" Height="20" Background="White" BorderBrush="Black" BorderThickness="4"/>
                            <Border Canvas.Left="-42" Canvas.Top="-84" Width="16" Height="16" Background="White" BorderBrush="Black" BorderThickness="4"/>
                            <Border Canvas.Left="-60" Canvas.Top="-66" Width="12" Height="12" Background="White" BorderBrush="Black" BorderThickness="4"/>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AgentTalk.BubbleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- the conversation as messages belongs to the messaging look -->
    <Style x:Key="AgentTalk.Thread" TargetType="ScrollViewer">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="AgentTalk.Message" TargetType="Border"/>
    <Style x:Key="AgentTalk.MessageText" TargetType="TextBlock"/>

    <!-- The player's lines, one under the other -->
    <Style x:Key="AgentTalk.OptionsBox" TargetType="Border">
        <Setter Property="Height" Value="240"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="BorderBrush" Value="{StaticResource AgentTalk.FrameBrush}"/>
        <Setter Property="BorderThickness" Value="4"/>
    </Style>

    <Style x:Key="AgentTalk.Options" TargetType="ItemsControl"/>

    <Style x:Key="AgentTalk.Option" TargetType="Button">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource AgentTalk.OptionBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4,0">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AgentTalk.OptionHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AgentTalk.OptionHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
