<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The academies as a scouting report pinned on the board: a masthead, then one typed sheet per academy
         with its juniors in pecking order; the player's line is run over with the highlighter, and a junior in
         his last academy season is noted in red ink. Builds on the shared paper resources of RetroTheme.xaml. -->

    <SolidColorBrush x:Key="Academies.WindowBackground" Color="#b08a5e"/>

    <!-- the swatch of a junior without a seat -->
    <SolidColorBrush x:Key="Academies.NoTeamBrush" Color="#c9c3b3"/>

    <Style x:Key="Academies.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

    <Style x:Key="Academies.Root" TargetType="Grid">
        <Setter Property="Margin" Value="24,22"/>
    </Style>

    <Style x:Key="Academies.Page" TargetType="Border" BasedOn="{StaticResource PaperCardStyle}">
        <Setter Property="Padding" Value="30,22"/>
    </Style>

    <!-- Masthead -->
    <Style x:Key="Academies.Header" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,3"/>
        <Setter Property="Padding" Value="0,0,0,8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="Academies.Kicker" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="Academies.Headline" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Academies.HeaderNote" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MaxWidth" Value="330"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="20,0,0,4"/>
    </Style>

    <!-- One sheet per academy -->
    <Style x:Key="Academies.Card" TargetType="Border">
        <Setter Property="Margin" Value="0,14,0,8"/>
    </Style>

    <Style x:Key="Academies.CardHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Academies.AcademyName" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Academies.AcademyTeams" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- the player's own academy, rubber-stamped -->
    <Style x:Key="Academies.YourAcademyTag" TargetType="Border">
        <Setter Property="BorderBrush" Value="#1d4ed8"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="16,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="-3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Academies.YourAcademyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#1d4ed8"/>
    </Style>

    <!-- Column captions -->
    <Style x:Key="Academies.ColumnHeaders" TargetType="Grid">
        <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>

    <Style x:Key="Academies.ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Academies.ColumnHeaderRight" TargetType="TextBlock" BasedOn="{StaticResource Academies.ColumnHeader}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- The juniors -->
    <Style x:Key="Academies.MemberRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkFaintBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,7"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                <Setter Property="Background" Value="{StaticResource HighlighterBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Academies.Rank" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>

    <Style x:Key="Academies.TeamSwatch" TargetType="Rectangle">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="Academies.MemberName" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Academies.MemberDetail" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding AgesOut}" Value="True">
                <Setter Property="Foreground" Value="#c1121f"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Academies.Value" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="Academies.ValueWrapped" TargetType="TextBlock" BasedOn="{StaticResource Academies.Value}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Academies.ValueRight" TargetType="TextBlock" BasedOn="{StaticResource Academies.Value}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style x:Key="Academies.SubValue" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- who left, typed under the sheet -->
    <Style x:Key="Academies.Former" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style x:Key="Academies.Empty" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>
</ResourceDictionary>
