<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Choosing the races of a season on a wall planner: kept races are ticked in pen, skipped ones crossed out in red.
         Builds on the shared paper/stamp/sticky-note resources of RetroTheme.xaml. -->

    <SolidColorBrush x:Key="RaceCalendarSelection.WindowBackground" Color="#f4f1e6"/>

    <Style x:Key="RaceCalendarSelection.ScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

    <Style x:Key="RaceCalendarSelection.Root" TargetType="Grid">
        <Setter Property="Margin" Value="30,24,30,26"/>
    </Style>

    <!-- Header -->
    <Style x:Key="RaceCalendarSelection.Header" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.Season" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="Foreground" Value="{StaticResource StampRedBrush}"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.Title" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}"/>

    <Style x:Key="RaceCalendarSelection.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHand}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{StaticResource PenBlueBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- Sticky note with the count -->
    <Style x:Key="RaceCalendarSelection.CountNote" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PostItBrush}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="20,0,0,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RaceCalendarSelection.CountText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHand}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.CountNumber" TargetType="Run">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- The planner grid: its outer rule on the top and left, each box closing its own right and bottom -->
    <Style x:Key="RaceCalendarSelection.Calendar" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="2,2,0,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- One box of the planner: ticked in pen when the race is kept, crossed out in red when it is skipped -->
    <Style x:Key="RaceCalendarSelection.Day" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border BorderBrush="{StaticResource InkBrush}"
                            BorderThickness="0,0,2,2"
                            Background="Transparent"
                            Padding="12,9"
                            MinHeight="108">
                        <Grid>
                            <ContentPresenter/>
                            <TextBlock x:Name="Tick"
                                       Text="✓"
                                       FontFamily="{StaticResource FontHand}"
                                       FontSize="30"
                                       Foreground="{StaticResource PenBlueBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,-10,0,0"
                                       Visibility="Collapsed"/>
                            <Grid x:Name="Cross">
                                <Line X1="0" Y1="0" X2="1" Y2="1" Stretch="Fill" Stroke="{StaticResource StampRedBrush}" StrokeThickness="3"/>
                                <Line X1="0" Y1="1" X2="1" Y2="0" Stretch="Fill" Stroke="{StaticResource StampRedBrush}" StrokeThickness="3"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Cross" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- the round number is stamped red; the other texts of a box take their colour from the box, which fades when skipped -->
    <Style x:Key="RaceCalendarSelection.DayRound" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPoster}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource StampRedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RaceCalendarSelection.DayName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTyped}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.DayCircuit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTyped}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.DayDate" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontTyped}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <!-- Footer: warning and confirm stamp -->
    <Style x:Key="RaceCalendarSelection.Footer" TargetType="Grid">
        <Setter Property="Margin" Value="0,22,0,0"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.Warning" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource StampRedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RaceCalendarSelection.ConfirmButton" TargetType="Button" BasedOn="{StaticResource StampButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
</ResourceDictionary>
