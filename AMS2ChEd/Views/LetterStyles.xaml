<?xml version="1.0" encoding="utf-8"?>
<!-- The buttons under a letter, shared by LetterWindow and AcademyLetterWindow -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LetterButtonBaseStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="LetterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LetterButtonBaseStyle}">
        <Setter Property="Background" Value="#c41e3a"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#d32f2f"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LetterAcceptButtonStyle" TargetType="Button" BasedOn="{StaticResource LetterButtonBaseStyle}">
        <Setter Property="Background" Value="#2e7d32"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#388e3c"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LetterRejectButtonStyle" TargetType="Button" BasedOn="{StaticResource LetterButtonBaseStyle}">
        <Setter Property="Background" Value="#c41e3a"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#d32f2f"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LetterNeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource LetterButtonBaseStyle}">
        <Setter Property="Background" Value="#2c2c2c"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3c3c3c"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
