<Window x:Class="AMS2ChEd.TeamSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        Title="{loc:Loc TeamSelectionWindow_Title}"
        Height="640" Width="860"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DesktopBrush}"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource W95ScrollBarStyle}"/>

        <!-- driver photo size, enlarged from code-behind when the window is wide -->
        <sys:Double x:Key="SeatPhotoWidth">78</sys:Double>
        <sys:Double x:Key="SeatPhotoHeight">100</sys:Double>
    </Window.Resources>

    <!-- A 90s desktop program: team list on the left, the seats of the chosen team on the right -->
    <ContentControl Style="{StaticResource W95RaisedStyle}" Margin="22">
        <Grid TextElement.FontFamily="{StaticResource FontDesktop}" TextElement.FontSize="14" TextElement.Foreground="Black">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Padding="7,5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#000080" Offset="0"/>
                        <GradientStop Color="#1084d0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="{loc:Loc TeamSelectionWindow_Title}" Foreground="White" FontWeight="Bold"/>
            </Border>

            <TextBlock Grid.Row="1" Text="{loc:Loc TeamSelectionWindow_Header}" Margin="8,10,8,6"/>

            <Grid Grid.Row="2" Margin="6,0,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TeamsColumn" Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Teams -->
                <ContentControl Grid.Column="0" Style="{StaticResource W95SunkenStyle}">
                    <ListBox x:Name="TeamsListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource W95ListBoxItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TeamsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="11" Height="11" Fill="{Binding TeamColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TeamName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ContentControl>

                <!-- Seats of the selected team -->
                <Border Grid.Column="1" Margin="8,8,0,0" BorderBrush="{StaticResource W95ShadowBrush}" BorderThickness="1">
                    <Border BorderBrush="{StaticResource W95LightBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SeatsHeaderText" FontWeight="Bold" Margin="12,10,12,4" TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SeatsItemsControl" VerticalAlignment="Top" Margin="8,4,8,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="SeatToReplace"
                                                         Style="{StaticResource W95RadioButtonStyle}"
                                                         Tag="{Binding}"
                                                         Margin="6,8"
                                                         Checked="SeatRadioButton_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Driver photo -->
                                                    <ContentControl Style="{StaticResource W95SunkenStyle}"
                                                                    Background="{StaticResource PhotoBackBrush}"
                                                                    Width="{DynamicResource SeatPhotoWidth}"
                                                                    Height="{DynamicResource SeatPhotoHeight}">
                                                        <Grid>
                                                            <Viewbox Margin="14">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Fill="#5e666e" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <Image Stretch="UniformToFill">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Source" Value="{Binding PhotoUrl}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PhotoUrl}" Value="{x:Null}">
                                                                                <Setter Property="Source" Value="{x:Null}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PhotoUrl}" Value="">
                                                                                <Setter Property="Source" Value="{x:Null}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PhotoUrl}" Value="N/A">
                                                                                <Setter Property="Source" Value="{x:Null}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </ContentControl>

                                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                                        <TextBlock Margin="0,4,0,0">
                                                            <Run Text="{Binding RoleName, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Nationality, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="6,4,6,6">
                <Button Content="{loc:Loc TeamSelectionWindow_ConfirmButton}"
                        Style="{StaticResource W95ButtonStyle}"
                        IsDefault="True"
                        Margin="0,0,8,0"
                        Click="ConfirmButton_Click"/>
                <Button Content="{loc:Loc TeamSelectionWindow_BackButton}"
                        Style="{StaticResource W95ButtonStyle}"
                        IsCancel="True"
                        Click="BackButton_Click"/>
            </StackPanel>

            <!-- Status bar -->
            <ContentControl Grid.Row="4" Style="{StaticResource W95SunkenStyle}" Background="{StaticResource W95FaceBrush}" Margin="6,0,6,4">
                <TextBlock x:Name="StatusText" Margin="7,3" Text=" " TextTrimming="CharacterEllipsis"/>
            </ContentControl>
        </Grid>
    </ContentControl>
</Window>
