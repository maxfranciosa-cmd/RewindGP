<Window x:Class="AMS2ChEd.TeamSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        Title="{loc:Loc TeamSelectionWindow_Title}"
        Height="640" Width="860"
        MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TeamSelection.WindowBackground}"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged">

    <!-- This window only holds structure. How each part looks comes from the "TeamSelection.*" styles
         of the active visual style (Themes/<style>/TeamSelection.xaml). -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource TeamSelection.ScrollBar}"/>

        <!-- driver photo size, enlarged from code-behind when the window is wide -->
        <sys:Double x:Key="SeatPhotoWidth">78</sys:Double>
        <sys:Double x:Key="SeatPhotoHeight">100</sys:Double>
    </Window.Resources>

    <!-- Team list on the left, the seats of the chosen team on the right -->
    <ContentControl Style="{StaticResource TeamSelection.Frame}">
        <Grid Style="{StaticResource TeamSelection.Root}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Style="{StaticResource TeamSelection.TitleBar}">
                <TextBlock Text="{loc:Loc TeamSelectionWindow_Title}" Style="{StaticResource TeamSelection.Title}"/>
            </Border>

            <TextBlock Grid.Row="1" Text="{loc:Loc TeamSelectionWindow_Header}" Style="{StaticResource TeamSelection.Intro}"/>

            <Grid Grid.Row="2" Style="{StaticResource TeamSelection.Body}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TeamsColumn" Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Teams -->
                <ContentControl Grid.Column="0" Style="{StaticResource TeamSelection.TeamList}">
                    <ListBox x:Name="TeamsListBox"
                             Style="{StaticResource TeamSelection.TeamListBox}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TeamsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Fill="{Binding TeamColor}" Style="{StaticResource TeamSelection.TeamSwatch}"/>
                                    <TextBlock Text="{Binding TeamName}" Style="{StaticResource TeamSelection.TeamName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ContentControl>

                <!-- Seats of the selected team -->
                <Border Grid.Column="1" Style="{StaticResource TeamSelection.SeatsFrame}">
                    <Border Style="{StaticResource TeamSelection.SeatsFrameInner}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SeatsHeaderText" Style="{StaticResource TeamSelection.SeatsHeader}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SeatsItemsControl" Style="{StaticResource TeamSelection.Seats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="SeatToReplace"
                                                         Style="{StaticResource TeamSelection.Seat}"
                                                         Tag="{Binding}"
                                                         Checked="SeatRadioButton_Checked">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Driver photo -->
                                                    <ContentControl Style="{StaticResource TeamSelection.SeatPhoto}"
                                                                    Width="{DynamicResource SeatPhotoWidth}"
                                                                    Height="{DynamicResource SeatPhotoHeight}">
                                                        <Grid>
                                                            <Viewbox Margin="14">
                                                                <Canvas Width="24" Height="24">
                                                                    <Path Style="{StaticResource TeamSelection.SeatPhotoPlaceholder}" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                                                                </Canvas>
                                                            </Viewbox>
                                                            <Image Stretch="UniformToFill">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Source" Value="{Binding PhotoUrl}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PhotoUrl}" Value="{x:Null}">
                                                                                <Setter Property="Source" Value="{x:Null}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PhotoUrl}" Value="">
                                                                                <Setter Property="Source" Value="{x:Null}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding PhotoUrl}" Value="N/A">
                                                                                <Setter Property="Source" Value="{x:Null}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </ContentControl>

                                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TeamSelection.SeatName}"/>
                                                        <TextBlock Style="{StaticResource TeamSelection.SeatDetail}">
                                                            <Run Text="{Binding RoleName, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Nationality, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Style="{StaticResource TeamSelection.Buttons}">
                <Button Content="{loc:Loc TeamSelectionWindow_ConfirmButton}"
                        Style="{StaticResource TeamSelection.ConfirmButton}"
                        IsDefault="True"
                        Click="ConfirmButton_Click"/>
                <Button Content="{loc:Loc TeamSelectionWindow_BackButton}"
                        Style="{StaticResource TeamSelection.BackButton}"
                        IsCancel="True"
                        Click="BackButton_Click"/>
            </StackPanel>

            <!-- Status bar: the seat picked so far -->
            <ContentControl Grid.Row="4" Style="{StaticResource TeamSelection.StatusBar}">
                <TextBlock x:Name="StatusText" Text=" " Style="{StaticResource TeamSelection.StatusText}"/>
            </ContentControl>
        </Grid>
    </ContentControl>
</Window>
