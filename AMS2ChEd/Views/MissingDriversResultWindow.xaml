<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AMS2ChEd.Views.MissingDriversResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        Title="{loc:Loc MissingDriversResultWindow_Title}"
        Height="520" Width="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Charcoal.BackgroundBrush}"
        ResizeMode="NoResize">

    <!-- A utility window: it wears the charcoal look ("Charcoal.*" resources of Themes/Charcoal/Base.xaml)
         whatever the visual style. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Background" Value="{StaticResource Charcoal.StripBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- one block per finishing position still without a driver -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Charcoal.PanelBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <!-- position in a white box at the start of the row -->
        <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Foreground" Value="{StaticResource Charcoal.BackgroundBrush}"/>
            <Setter Property="Background" Value="{StaticResource Charcoal.TextBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,11"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="DriverCombo" TargetType="ComboBox" BasedOn="{StaticResource Charcoal.ComboBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowCheck" TargetType="CheckBox" BasedOn="{StaticResource Charcoal.CheckBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Charcoal.TitleBarStyle}">
            <TextBlock Text="{loc:Loc MissingDriversResultWindow_Header}" Style="{StaticResource Charcoal.TitleTextStyle}"/>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{loc:Loc MissingDriversResultWindow_Description}"
                   Style="{StaticResource Charcoal.BodyTextStyle}"
                   Foreground="{StaticResource Charcoal.TextSoftBrush}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,10,0,14"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="QualiSection" Margin="0,0,0,16">
                    <TextBlock Text="{loc:Loc MissingDriversResultWindow_MissingQualifyingHeader}" Style="{StaticResource SectionHeaderText}"/>
                    <ItemsControl x:Name="QualiPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Position, StringFormat='P{0}'}"
                                                   Style="{StaticResource RowText}"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableDrivers}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedDriver}"
                                                  Style="{StaticResource DriverCombo}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="RaceSection">
                    <!-- the column captions sit at the end of the section's title strip -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="4" Text="{loc:Loc MissingDriversResultWindow_MissingRaceHeader}" Style="{StaticResource SectionHeaderText}"/>
                        <TextBlock Grid.Column="2" Text="DNF" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="3" Text="{loc:Loc MissingDriversResultWindow_FastestLapColumnHeader}" Style="{StaticResource HeaderText}"/>
                    </Grid>

                    <ItemsControl x:Name="RacePanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Position, StringFormat='P{0}'}"
                                                   Style="{StaticResource RowText}"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableDrivers}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedDriver}"
                                                  Style="{StaticResource DriverCombo}"/>
                                        <CheckBox Grid.Column="2"
                                                  IsChecked="{Binding IsDnf}"
                                                  Style="{StaticResource RowCheck}"/>
                                        <CheckBox Grid.Column="3"
                                                  IsChecked="{Binding IsFastestLap}"
                                                  Style="{StaticResource RowCheck}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3"
                Content="{loc:Loc MissingDriversResultWindow_ConfirmButton}"
                Style="{StaticResource Charcoal.DialogPrimaryButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,14,0,0"
                Click="ConfirmButton_Click"/>
    </Grid>
</Window>
