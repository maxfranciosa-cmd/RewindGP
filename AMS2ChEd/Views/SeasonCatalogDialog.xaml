<Window x:Class="AMS2ChEd.Dialogs.SeasonCatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        Title="{loc:Loc SeasonCatalogDialog_Title}"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Charcoal.BackgroundBrush}"
        Foreground="{StaticResource Charcoal.TextBrush}">

    <!-- A utility window: it wears the charcoal look ("Charcoal.*" resources of Themes/Charcoal/Base.xaml)
         whatever the visual style. -->
    <Window.Resources>
        <!-- an installed season that is up to date -->
        <SolidColorBrush x:Key="UpToDateBrush" Color="#2d7a3e"/>

        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">

        <Border Style="{StaticResource Charcoal.TitleBarStyle}">
            <TextBlock Text="{loc:Loc SeasonCatalogDialog_Header}" Style="{StaticResource Charcoal.TitleTextStyle}"/>
        </Border>
        <TextBlock Text="{loc:Loc SeasonCatalogDialog_Description}"
                   Style="{StaticResource Charcoal.BodyTextStyle}"
                   Foreground="{StaticResource Charcoal.TextSoftBrush}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,10,0,14"/>

        <!-- Grid header -->
        <Grid Background="{StaticResource Charcoal.StripBrush}" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{loc:Loc SeasonCatalogDialog_SeasonColumnHeader}" Style="{StaticResource HeaderText}" Margin="0,8"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc SeasonCatalogDialog_StatusColumnHeader}" Style="{StaticResource HeaderText}"/>
            <TextBlock Grid.Column="3" Text="{loc:Loc SeasonCatalogDialog_SizeColumnHeader}" Style="{StaticResource HeaderText}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
        </Grid>

        <!-- Season rows: one block per season -->
        <ItemsControl x:Name="SeasonsItemsControl" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{StaticResource Charcoal.PanelBrush}" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelect}"
                                  Style="{StaticResource Charcoal.CheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  Margin="12,9,0,9"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   Style="{StaticResource Charcoal.HeadingTextStyle}"
                                   FontSize="19" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <Border Grid.Column="2" VerticalAlignment="Center"
                                Padding="8,3" Margin="0,0,8,0" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Availability}" Value="UpdateAvailable">
                                            <Setter Property="Background" Value="{StaticResource Charcoal.RedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Availability}" Value="NotInstalled">
                                            <Setter Property="Background" Value="{StaticResource Charcoal.BackgroundBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Availability}" Value="UpToDate">
                                            <Setter Property="Background" Value="{StaticResource UpToDateBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusLabel}"
                                       Style="{StaticResource Charcoal.BodyTextStyle}"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding FileSizeLabel}"
                                   Style="{StaticResource Charcoal.BodyTextStyle}"
                                   Foreground="{StaticResource Charcoal.TextSoftBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Status label (shown during install) -->
        <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock x:Name="StatusLabel"
                       Style="{StaticResource Charcoal.BodyTextStyle}"
                       Foreground="{StaticResource Charcoal.AccentTextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CloseButton"
                    Grid.Column="0"
                    Content="{loc:Loc SeasonCatalogDialog_CloseButton}"
                    Style="{StaticResource Charcoal.DialogSecondaryButtonStyle}"
                    Click="OnCloseClicked"/>

            <Button x:Name="DownloadButton"
                    Grid.Column="2"
                    Content="{loc:Loc SeasonCatalogDialog_DownloadButton}"
                    Style="{StaticResource Charcoal.DialogPrimaryButtonStyle}"
                    IsEnabled="False"
                    Click="OnDownloadClicked"/>
        </Grid>

    </StackPanel>
</Window>
