<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.Views.ConstructorAccoladesWindow"
        Title="Constructor Accolades"
        Height="699" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a1a">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Team name + color strip -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="TeamColorStrip"
                    Grid.Column="0"
                    Width="6"
                    CornerRadius="3"
                    Margin="0,0,12,0"/>

            <TextBlock x:Name="TeamNameText"
                       Grid.Column="1"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>

        <!-- Red divider -->
        <Border Grid.Row="2"
                Height="2"
                Background="#dc143c"
                Margin="0,9,0,9"
                VerticalAlignment="Center"/>

        <!-- Stat blocks -->
        <UniformGrid Grid.Row="3" Columns="3" Rows="1">

            <!-- Wins -->
            <Border Background="#0f0f0f"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,8,0"
                    Padding="16,14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="WinsText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="WINS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Podiums -->
            <Border Background="#0f0f0f"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,8,0"
                    Padding="16,14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="PodiumsText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="PODIUMS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Poles -->
            <Border Background="#0f0f0f"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="PolesText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="POLES"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Championships -->
        <Border Grid.Row="5"
                Background="#0f0f0f"
                BorderBrush="#2a2a2a"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,14">
            <StackPanel>
                <TextBlock Text="CHAMPIONSHIPS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#666666"
                           Margin="0,0,0,10"/>
                <WrapPanel x:Name="ChampionshipsPanel"/>
                <TextBlock x:Name="NoChampionshipsText"
                           Text="—"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Previous Seasons -->
        <Border Grid.Row="7"
                Background="#0f0f0f"
                BorderBrush="#2a2a2a"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PREVIOUS SEASONS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#666666"/>

                <!-- Column headers -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="YEAR" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="POS" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="POINTS" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="WINS" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="PODIUMS" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="POLES" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="4"
                              MinHeight="160"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SeasonsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Year}" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Position, StringFormat=\{0\}.}" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Points}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Wins}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Podiums}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Poles}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="NoSeasonsText"
                           Grid.Row="4"
                           Text="—"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
