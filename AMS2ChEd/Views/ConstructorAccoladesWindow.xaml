<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.Views.ConstructorAccoladesWindow"
        Title="{loc:Loc ConstructorAccoladesWindow_Title}"
        Height="700" Width="560"
        MinHeight="540" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource ManilaBrush}"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TypedLabelStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CellStyle" TargetType="TextBlock" BasedOn="{StaticResource TypedTextStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TotalNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource PosterTextStyle}">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="LeaderStyle" TargetType="Line">
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="{StaticResource InkFaintBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="1 2"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="8,0,0,7"/>
        </Style>
    </Window.Resources>

    <!-- A team's file: manila folder with a typed sheet, the tab marked in the team colour -->
    <Grid Margin="18,10,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder tab with team colour strip -->
        <Border Grid.Row="0" Background="{StaticResource ManilaLightBrush}" HorizontalAlignment="Left" CornerRadius="8,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="TeamColorStrip" Width="12" CornerRadius="8,0,0,0"/>
                <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_Title}" Style="{StaticResource TypedTextStyle}" Margin="14,8,18,10"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PaperCardStyle}" Padding="22">
            <Grid x:Name="PaperGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Name, totals and championships -->
                <StackPanel x:Name="ProfileBlock" Grid.ColumnSpan="2">
                    <TextBlock x:Name="TeamNameText" Style="{StaticResource PosterTextStyle}" FontSize="36" TextWrapping="Wrap"/>

                    <!-- Totals -->
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_WinsLabel}" Style="{StaticResource TypedTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <TextBlock x:Name="WinsText" Style="{StaticResource TotalNumberStyle}"/>
                        <Line Style="{StaticResource LeaderStyle}"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_PodiumsLabel}" Style="{StaticResource TypedTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PodiumsText" Style="{StaticResource TotalNumberStyle}"/>
                        <Line Style="{StaticResource LeaderStyle}"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_PolesLabel}" Style="{StaticResource TypedTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PolesText" Style="{StaticResource TotalNumberStyle}"/>
                        <Line Style="{StaticResource LeaderStyle}"/>
                    </DockPanel>

                    <!-- Championships -->
                    <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2" Margin="0,16,0,10">
                        <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_ChampionshipsLabel}" Style="{StaticResource SectionHeaderStyle}"/>
                    </Border>
                    <WrapPanel x:Name="ChampionshipsPanel"/>
                    <TextBlock x:Name="NoChampionshipsText"
                               Text="—"
                               Style="{StaticResource TypedTextStyle}"
                               FontSize="22"
                               Foreground="{StaticResource InkFaintBrush}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Previous Seasons -->
                <Grid x:Name="SeasonsBlock" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_PreviousSeasonsLabel}" Style="{StaticResource SectionHeaderStyle}"/>
                    </Border>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc ConstructorAccoladesWindow_YearColumnHeader}" Style="{StaticResource ColumnHeaderStyle}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc ConstructorAccoladesWindow_PositionColumnHeader}" Style="{StaticResource ColumnHeaderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{loc:Loc ConstructorAccoladesWindow_PointsColumnHeader}" Style="{StaticResource ColumnHeaderStyle}"/>
                        <TextBlock Grid.Column="3" Text="{loc:Loc ConstructorAccoladesWindow_WinsColumnHeader}" Style="{StaticResource ColumnHeaderStyle}"/>
                        <TextBlock Grid.Column="4" Text="{loc:Loc ConstructorAccoladesWindow_PodiumsColumnHeader}" Style="{StaticResource ColumnHeaderStyle}"/>
                        <TextBlock Grid.Column="5" Text="{loc:Loc ConstructorAccoladesWindow_PolesColumnHeader}" Style="{StaticResource ColumnHeaderStyle}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  MinHeight="120"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SeasonsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource InkFaintBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Year}" Style="{StaticResource CellStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Position, StringFormat=\{0\}.}" Style="{StaticResource CellStyle}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Points}" Style="{StaticResource CellStyle}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Wins}" Style="{StaticResource CellStyle}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Podiums}" Style="{StaticResource CellStyle}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Poles}" Style="{StaticResource CellStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="NoSeasonsText"
                               Grid.Row="2"
                               Text="—"
                               Style="{StaticResource TypedTextStyle}"
                               FontSize="22"
                               Foreground="{StaticResource InkFaintBrush}"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
