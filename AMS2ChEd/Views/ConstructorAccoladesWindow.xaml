<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.Views.ConstructorAccoladesWindow"
        Title="{loc:Loc ConstructorAccoladesWindow_Title}"
        Height="700" Width="560"
        MinHeight="540" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource Accolades.WindowBackground}"
        SizeChanged="Window_SizeChanged">

    <!-- This window only holds structure. How each part looks comes from the "Accolades.*" styles of the
         active visual style (Themes/<style>/Accolades.xaml), shared with DriverAccoladesWindow. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Accolades.ScrollBar}"/>
    </Window.Resources>

    <!-- A team's file: the title marked in the team colour, then the profile sheet -->
    <Grid Style="{StaticResource Accolades.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title with team colour strip -->
        <Border Grid.Row="0" Style="{StaticResource Accolades.Tab}">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="TeamColorStrip" Style="{StaticResource Accolades.TeamColorStrip}"/>
                <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_Title}" Style="{StaticResource Accolades.TeamTabText}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Accolades.Sheet}">
            <Grid x:Name="PaperGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Name, totals and championships -->
                <StackPanel x:Name="ProfileBlock" Grid.ColumnSpan="2">
                    <TextBlock x:Name="TeamNameText" Style="{StaticResource Accolades.Name}"/>

                    <!-- Totals -->
                    <StackPanel Style="{StaticResource Accolades.Totals}">
                        <DockPanel Style="{StaticResource Accolades.TotalRow}">
                            <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_WinsLabel}" Style="{StaticResource Accolades.TotalLabel}"/>
                            <TextBlock x:Name="WinsText" Style="{StaticResource Accolades.TotalNumber}"/>
                            <Line Style="{StaticResource Accolades.Leader}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Accolades.TotalRow}">
                            <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_PodiumsLabel}" Style="{StaticResource Accolades.TotalLabel}"/>
                            <TextBlock x:Name="PodiumsText" Style="{StaticResource Accolades.TotalNumber}"/>
                            <Line Style="{StaticResource Accolades.Leader}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Accolades.TotalRow}">
                            <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_PolesLabel}" Style="{StaticResource Accolades.TotalLabel}"/>
                            <TextBlock x:Name="PolesText" Style="{StaticResource Accolades.TotalNumber}"/>
                            <Line Style="{StaticResource Accolades.Leader}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Championships -->
                    <Border Style="{StaticResource Accolades.SectionHeader}">
                        <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_ChampionshipsLabel}" Style="{StaticResource Accolades.SectionTitle}"/>
                    </Border>
                    <WrapPanel x:Name="ChampionshipsPanel"/>
                    <TextBlock x:Name="NoChampionshipsText"
                               Text="—"
                               Style="{StaticResource Accolades.Empty}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Previous Seasons -->
                <Grid x:Name="SeasonsBlock" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Accolades.SeasonsHeader}">
                        <TextBlock Text="{loc:Loc ConstructorAccoladesWindow_PreviousSeasonsLabel}" Style="{StaticResource Accolades.SectionTitle}"/>
                    </Border>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Style="{StaticResource Accolades.ColumnHeaders}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc ConstructorAccoladesWindow_YearColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc ConstructorAccoladesWindow_PositionColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="2" Text="{loc:Loc ConstructorAccoladesWindow_PointsColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="3" Text="{loc:Loc ConstructorAccoladesWindow_WinsColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="4" Text="{loc:Loc ConstructorAccoladesWindow_PodiumsColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="5" Text="{loc:Loc ConstructorAccoladesWindow_PolesColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  MinHeight="120"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SeasonsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Accolades.SeasonRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Year}" Style="{StaticResource Accolades.Cell}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Position, StringFormat=\{0\}.}" Style="{StaticResource Accolades.Cell}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Points}" Style="{StaticResource Accolades.Cell}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Wins}" Style="{StaticResource Accolades.Cell}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Podiums}" Style="{StaticResource Accolades.Cell}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Poles}" Style="{StaticResource Accolades.Cell}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="NoSeasonsText"
                               Grid.Row="2"
                               Text="—"
                               Style="{StaticResource Accolades.Empty}"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
