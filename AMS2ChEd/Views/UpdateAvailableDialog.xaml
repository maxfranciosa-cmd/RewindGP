<Window x:Class="AMS2ChEd.Dialogs.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        Title="{loc:Loc UpdateAvailableDialog_Title}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Charcoal.BackgroundBrush}"
        Foreground="{StaticResource Charcoal.TextBrush}">

    <!-- A utility window: it wears the charcoal look ("Charcoal.*" resources of Themes/Charcoal/Base.xaml)
         whatever the visual style. -->
    <Window.Resources>
        <Style x:Key="VersionText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
            <Setter Property="FontSize" Value="30"/>
        </Style>
        <!-- two buttons share the narrow dialog: a tighter block keeps the longer captions on one line -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource Charcoal.DialogPrimaryButtonStyle}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="8,12"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource Charcoal.DialogSecondaryButtonStyle}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="8,12"/>
        </Style>
        <Style x:Key="DescriptionText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">

        <Border Style="{StaticResource Charcoal.TitleBarStyle}">
            <TextBlock Text="{loc:Loc UpdateAvailableDialog_Header}" Style="{StaticResource Charcoal.TitleTextStyle}"/>
        </Border>

        <!-- the installed version and the new one -->
        <Border Style="{StaticResource Charcoal.PanelStyle}" Padding="16,12" Margin="0,14,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="{loc:Loc UpdateAvailableDialog_CurrentLabel}" Style="{StaticResource Charcoal.FieldLabelStyle}" Margin="0"/>
                    <TextBlock x:Name="CurrentVersionText" Style="{StaticResource VersionText}" Foreground="{StaticResource Charcoal.TextMutedBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" FontSize="24" Foreground="{StaticResource Charcoal.AccentTextBrush}"
                           VerticalAlignment="Bottom" Margin="16,0,16,6"/>
                <StackPanel Grid.Column="2">
                    <Label Content="{loc:Loc UpdateAvailableDialog_NewVersionLabel}" Style="{StaticResource Charcoal.FieldLabelStyle}" Margin="0"/>
                    <TextBlock x:Name="LatestVersionText" Style="{StaticResource VersionText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Default: automatic download & install -->
        <StackPanel x:Name="AutoPanel">
            <TextBlock Text="{loc:Loc UpdateAvailableDialog_AutoDescription}" Style="{StaticResource DescriptionText}"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{loc:Loc UpdateAvailableDialog_NotNowButton}" Style="{StaticResource SecondaryButton}" Click="OnSkipClicked"/>
                <Button Grid.Column="2" Content="{loc:Loc UpdateAvailableDialog_DownloadAndInstallButton}" Style="{StaticResource PrimaryButton}" Click="OnDownloadAndInstallClicked"/>
            </Grid>
            <Button Content="{loc:Loc UpdateAvailableDialog_ManualFallbackLink}"
                    Style="{StaticResource Charcoal.LinkButtonStyle}"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    Click="OnManualFallbackClicked"/>
        </StackPanel>

        <!-- Manual fallback step 1: prompt to go to download page -->
        <StackPanel x:Name="Step1Panel" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc UpdateAvailableDialog_Step1Description}" Style="{StaticResource DescriptionText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{loc:Loc UpdateAvailableDialog_NotNowButton}" Style="{StaticResource SecondaryButton}" Click="OnSkipClicked"/>
                <Button Grid.Column="2" Content="{loc:Loc UpdateAvailableDialog_GoToDownloadPageButton}" Style="{StaticResource PrimaryButton}" Click="OnGoToDownloadPageClicked"/>
            </Grid>
        </StackPanel>

        <!-- Manual fallback step 2: locate the downloaded file -->
        <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
            <TextBlock Text="{loc:Loc UpdateAvailableDialog_Step2Description}" Style="{StaticResource DescriptionText}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{loc:Loc UpdateAvailableDialog_NotNowButton}" Style="{StaticResource SecondaryButton}" Click="OnSkipClicked"/>
                <Button Grid.Column="2" Content="{loc:Loc UpdateAvailableDialog_DownloadedItButton}" Style="{StaticResource PrimaryButton}" Click="OnLocateFileClicked"/>
            </Grid>
        </StackPanel>

    </StackPanel>
</Window>
