<Window x:Class="AMS2ChEd.RaceCalendarSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc RaceCalendarSelectionWindow_Title}"
        Height="900" Width="1000"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PlannerBrush}"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

        <!-- One box of the planner: ticked in pen when the race is kept, crossed out in red when it is skipped -->
        <Style x:Key="PlannerDayStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="0,0,2,2"
                                Background="Transparent"
                                Padding="12,9"
                                MinHeight="108">
                            <Grid>
                                <ContentPresenter/>
                                <TextBlock x:Name="Tick"
                                           Text="✓"
                                           FontFamily="{StaticResource FontHand}"
                                           FontSize="30"
                                           Foreground="{StaticResource PenBlueBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="0,-10,0,0"
                                           Visibility="Collapsed"/>
                                <Grid x:Name="Cross">
                                    <Line X1="0" Y1="0" X2="1" Y2="1" Stretch="Fill" Stroke="{StaticResource StampRedBrush}" StrokeThickness="3"/>
                                    <Line X1="0" Y1="1" X2="1" Y2="0" Stretch="Fill" Stroke="{StaticResource StampRedBrush}" StrokeThickness="3"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Cross" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- A season planner -->
    <Grid Margin="30,24,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="SeasonText"
                           FontFamily="{StaticResource FontPoster}"
                           FontSize="46"
                           Foreground="{StaticResource StampRedBrush}"/>
                <TextBlock Text="{loc:Loc RaceCalendarSelectionWindow_Header}"
                           Style="{StaticResource TypedTextStyle}"/>
                <TextBlock Text="{loc:Loc RaceCalendarSelectionWindow_Subtitle}"
                           FontFamily="{StaticResource FontHand}"
                           FontSize="17"
                           Foreground="{StaticResource PenBlueBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Sticky note with the count -->
            <Border Grid.Column="1" Background="{StaticResource PostItBrush}" Padding="16,12" VerticalAlignment="Bottom" Margin="20,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <TextBlock FontFamily="{StaticResource FontHand}" FontSize="18" Foreground="{StaticResource InkBrush}">
                    <Run Text="{loc:Loc RaceCalendarSelectionWindow_RacesSelectedLabel}"/>
                    <Run x:Name="SelectedCountText" Text="0" FontWeight="Bold"/>
                    <Run Text="/"/>
                    <Run x:Name="TotalCountText" Text="0"/>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Race boxes -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="2,2,0,0" VerticalAlignment="Top">
                <ItemsControl x:Name="RaceItems" Tag="4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Style="{StaticResource PlannerDayStyle}">
                                <StackPanel>
                                    <!-- Round Number -->
                                    <TextBlock Text="{Binding RoundNumber}" FontFamily="{StaticResource FontPoster}" FontSize="22">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource StampRedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource InkFaintBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Race Name -->
                                    <TextBlock Text="{Binding RaceName}"
                                               FontFamily="{StaticResource FontTyped}"
                                               FontSize="18"
                                               TextWrapping="Wrap"/>

                                    <!-- Circuit Name -->
                                    <TextBlock Text="{Binding CircuitName}"
                                               FontFamily="{StaticResource FontTyped}"
                                               FontSize="14"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>

                                    <!-- Race Date -->
                                    <TextBlock Text="{Binding FormattedDate}"
                                               FontFamily="{StaticResource FontTyped}"
                                               FontSize="14"
                                               Opacity="0.7"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- Footer: warning and confirm stamp -->
        <Grid Grid.Row="2" Margin="0,22,0,0">
            <TextBlock x:Name="WarningText"
                       Text="{loc:Loc RaceCalendarSelectionWindow_WarningText}"
                       Style="{StaticResource TypedTextStyle}"
                       Foreground="{StaticResource StampRedBrush}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <Button x:Name="ConfirmButton"
                    Content="{loc:Loc RaceCalendarSelectionWindow_ConfirmButton}"
                    Style="{StaticResource StampButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</Window>
