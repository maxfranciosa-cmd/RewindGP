<Window x:Class="AMS2ChEd.RaceCalendarSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc RaceCalendarSelectionWindow_Title}"
        Height="900" Width="1000"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource RaceCalendarSelection.WindowBackground}"
        SizeChanged="Window_SizeChanged">

    <!-- This window only holds structure. How each part looks comes from the "RaceCalendarSelection.*" styles
         of the active visual style (Themes/<style>/RaceCalendarSelection.xaml), including how a race box shows
         whether its race is kept or skipped. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource RaceCalendarSelection.ScrollBar}"/>
    </Window.Resources>

    <Grid Style="{StaticResource RaceCalendarSelection.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Style="{StaticResource RaceCalendarSelection.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SeasonText"
                               Style="{StaticResource RaceCalendarSelection.Season}"/>
                    <TextBlock Text="{loc:Loc RaceCalendarSelectionWindow_Header}"
                               Style="{StaticResource RaceCalendarSelection.Title}"/>
                    <TextBlock Text="{loc:Loc RaceCalendarSelectionWindow_Subtitle}"
                               Style="{StaticResource RaceCalendarSelection.Subtitle}"/>
                </StackPanel>

                <!-- How many races are kept -->
                <Border Grid.Column="1" Style="{StaticResource RaceCalendarSelection.CountNote}">
                    <TextBlock Style="{StaticResource RaceCalendarSelection.CountText}">
                        <Run Text="{loc:Loc RaceCalendarSelectionWindow_RacesSelectedLabel}"/>
                        <Run x:Name="SelectedCountText" Text="0" Style="{StaticResource RaceCalendarSelection.CountNumber}"/>
                        <Run Text="/"/>
                        <Run x:Name="TotalCountText" Text="0"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Race boxes -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource RaceCalendarSelection.Calendar}">
                <ItemsControl x:Name="RaceItems" Tag="4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Style="{StaticResource RaceCalendarSelection.Day}">
                                <StackPanel>
                                    <!-- Round Number -->
                                    <TextBlock Text="{Binding RoundNumber}"
                                               Style="{StaticResource RaceCalendarSelection.DayRound}"/>

                                    <!-- Race Name -->
                                    <TextBlock Text="{Binding RaceName}"
                                               Style="{StaticResource RaceCalendarSelection.DayName}"/>

                                    <!-- Circuit Name -->
                                    <TextBlock Text="{Binding CircuitName}"
                                               Style="{StaticResource RaceCalendarSelection.DayCircuit}"/>

                                    <!-- Race Date -->
                                    <TextBlock Text="{Binding FormattedDate}"
                                               Style="{StaticResource RaceCalendarSelection.DayDate}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </ScrollViewer>

        <!-- Footer: warning and confirm button -->
        <Grid Grid.Row="2" Style="{StaticResource RaceCalendarSelection.Footer}">
            <TextBlock x:Name="WarningText"
                       Text="{loc:Loc RaceCalendarSelectionWindow_WarningText}"
                       Style="{StaticResource RaceCalendarSelection.Warning}"
                       Visibility="Collapsed"/>

            <Button x:Name="ConfirmButton"
                    Content="{loc:Loc RaceCalendarSelectionWindow_ConfirmButton}"
                    Style="{StaticResource RaceCalendarSelection.ConfirmButton}"
                    Click="ConfirmButton_Click"/>
        </Grid>
    </Grid>
</Window>
