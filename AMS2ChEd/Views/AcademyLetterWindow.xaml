<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AMS2ChEd.Views.AcademyLetterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        xmlns:views="clr-namespace:AMS2ChEd.Views"
        Height="1000" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5dc"
        ResizeMode="NoResize">

    <!-- A letter from the player's agent on the shared letter paper: the academy step (career
         start or off-season), or the farewell to a player who aged out of his academy -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LetterStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AcademyOptionStyle" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="Georgia"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Foreground" Value="#2c2c2c"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- the shared letter paper, with the academy choices under the text -->
        <views:LetterPaper x:Name="Paper" Grid.Row="0" Margin="40,30,40,20">
            <views:LetterPaper.ExtraContent>
                <!-- no x:Name: LetterPaper has its own namescope; code-behind reaches it via Paper.ExtraContent -->
                <ItemsControl Margin="0,30,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Academies"
                                         Style="{StaticResource AcademyOptionStyle}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Checked="Academy_Checked">
                                <StackPanel Margin="8,-4,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Teams}" FontSize="17" Foreground="#555555" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </views:LetterPaper.ExtraContent>
        </views:LetterPaper>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">
            <Button x:Name="ConfirmButton"
                    Style="{StaticResource LetterAcceptButtonStyle}"
                    Click="ConfirmButton_Click"
                    Visibility="Collapsed"/>
            <Button x:Name="LeaveButton"
                    Content="{loc:Loc AcademyLetterWindow_LeaveButton}"
                    Style="{StaticResource LetterRejectButtonStyle}"
                    Click="LeaveButton_Click"
                    Visibility="Collapsed"/>
            <Button x:Name="DeclineButton"
                    Style="{StaticResource LetterNeutralButtonStyle}"
                    Click="DeclineButton_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
