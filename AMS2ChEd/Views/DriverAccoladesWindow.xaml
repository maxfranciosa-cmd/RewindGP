<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.Views.DriverAccoladesWindow"
        Title="{loc:Loc DriverAccoladesWindow_Title}"
        Height="660" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a1a">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: photo + name -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Driver photo -->
            <Grid Grid.Column="0">
                <Border Width="80" Height="114"
                        CornerRadius="4"
                        Background="#2a2a2a"
                        BorderBrush="#dc143c"
                        BorderThickness="2">
                    <Grid>
                        <TextBlock x:Name="PhotoPlaceholder"
                                   Text="?"
                                   FontSize="36"
                                   Foreground="#555555"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="DriverPhoto"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Driver name + label -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock x:Name="DriverNameText"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="TeamNameText"
                           FontSize="18"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="AgeText"
                           FontSize="14"
                           Foreground="#666666"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Red divider -->
        <Border Grid.Row="1"
                Height="2"
                Background="#dc143c"
                Margin="0,9,0,9"
                VerticalAlignment="Center"/>

        <!-- Stat blocks -->
        <UniformGrid Grid.Row="2" Columns="3" Rows="1">

            <!-- Wins -->
            <Border Background="#0f0f0f"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,8,0"
                    Padding="16,14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="WinsText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc DriverAccoladesWindow_WinsLabel}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Podiums -->
            <Border Background="#0f0f0f"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,8,0"
                    Padding="16,14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="PodiumsText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc DriverAccoladesWindow_PodiumsLabel}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Poles -->
            <Border Background="#0f0f0f"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16,14">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="PolesText"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc DriverAccoladesWindow_PolesLabel}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Championships -->
        <Border Grid.Row="4"
                Background="#0f0f0f"
                BorderBrush="#2a2a2a"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,14">
            <StackPanel>
                <TextBlock Text="{loc:Loc DriverAccoladesWindow_ChampionshipsLabel}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#666666"
                           Margin="0,0,0,10"/>
                <WrapPanel x:Name="ChampionshipsPanel">
                    <!-- championship year badges populated in code-behind -->
                </WrapPanel>
                <TextBlock x:Name="NoChampionshipsText"
                           Text="—"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Previous Seasons -->
        <Border Grid.Row="6"
                Background="#0f0f0f"
                BorderBrush="#2a2a2a"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{loc:Loc DriverAccoladesWindow_PreviousSeasonsLabel}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#666666"/>

                <!-- Column headers -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*" MinWidth="75"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc DriverAccoladesWindow_YearColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{loc:Loc DriverAccoladesWindow_PositionColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{loc:Loc DriverAccoladesWindow_TeamColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="3" Text="{loc:Loc DriverAccoladesWindow_RacesColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{loc:Loc DriverAccoladesWindow_WinsColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{loc:Loc DriverAccoladesWindow_PodiumsColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="{loc:Loc DriverAccoladesWindow_PolesColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="{loc:Loc DriverAccoladesWindow_PointsColumnHeader}" FontSize="10" FontWeight="Bold" Foreground="#666666" HorizontalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="4"
                              MinHeight="160"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SeasonsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="45"/>
                                            <ColumnDefinition Width="*" MinWidth="75"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Year}" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Position, StringFormat=\{0\}.}" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TeamName}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding TeamName}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Races}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Wins}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Podiums}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding Poles}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding Points}" FontSize="13" Foreground="#cccccc" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="NoSeasonsText"
                           Grid.Row="4"
                           Text="—"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
