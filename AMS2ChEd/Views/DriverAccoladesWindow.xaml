<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.Views.DriverAccoladesWindow"
        Title="{loc:Loc DriverAccoladesWindow_Title}"
        Height="720" Width="620"
        MinHeight="560" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource Accolades.WindowBackground}"
        SizeChanged="Window_SizeChanged">

    <!-- This window only holds structure. How each part looks comes from the "Accolades.*" styles of the
         active visual style (Themes/<style>/Accolades.xaml), shared with ConstructorAccoladesWindow. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Accolades.ScrollBar}"/>
    </Window.Resources>

    <!-- A driver's file: the title, then the profile sheet -->
    <Grid Style="{StaticResource Accolades.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0" Style="{StaticResource Accolades.Tab}">
            <TextBlock Text="{loc:Loc DriverAccoladesWindow_Title}" Style="{StaticResource Accolades.TabText}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Accolades.Sheet}">
            <Grid x:Name="PaperGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Profile, totals and championships -->
                <StackPanel x:Name="ProfileBlock" Grid.ColumnSpan="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <TextBlock x:Name="TeamNameText" Style="{StaticResource Accolades.Caption}"/>
                            <TextBlock x:Name="DriverNameText" Style="{StaticResource Accolades.Name}"/>
                            <TextBlock x:Name="AgeText" Style="{StaticResource Accolades.Detail}"/>
                            <TextBlock x:Name="RoleText" Style="{StaticResource Accolades.Detail}"/>
                        </StackPanel>

                        <!-- Driver photo -->
                        <Border Grid.Column="1" Style="{StaticResource Accolades.Photo}">
                            <Grid>
                                <TextBlock x:Name="PhotoPlaceholder"
                                           Text="?"
                                           Style="{StaticResource Accolades.PhotoPlaceholder}"/>
                                <Image x:Name="DriverPhoto"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Totals -->
                    <StackPanel Style="{StaticResource Accolades.Totals}">
                        <DockPanel Style="{StaticResource Accolades.TotalRow}">
                            <TextBlock Text="{loc:Loc DriverAccoladesWindow_WinsLabel}" Style="{StaticResource Accolades.TotalLabel}"/>
                            <TextBlock x:Name="WinsText" Style="{StaticResource Accolades.TotalNumber}"/>
                            <Line Style="{StaticResource Accolades.Leader}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Accolades.TotalRow}">
                            <TextBlock Text="{loc:Loc DriverAccoladesWindow_PodiumsLabel}" Style="{StaticResource Accolades.TotalLabel}"/>
                            <TextBlock x:Name="PodiumsText" Style="{StaticResource Accolades.TotalNumber}"/>
                            <Line Style="{StaticResource Accolades.Leader}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Accolades.TotalRow}">
                            <TextBlock Text="{loc:Loc DriverAccoladesWindow_PolesLabel}" Style="{StaticResource Accolades.TotalLabel}"/>
                            <TextBlock x:Name="PolesText" Style="{StaticResource Accolades.TotalNumber}"/>
                            <Line Style="{StaticResource Accolades.Leader}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Championships -->
                    <Border Style="{StaticResource Accolades.SectionHeader}">
                        <TextBlock Text="{loc:Loc DriverAccoladesWindow_ChampionshipsLabel}" Style="{StaticResource Accolades.SectionTitle}"/>
                    </Border>
                    <WrapPanel x:Name="ChampionshipsPanel">
                        <!-- championship years populated in code-behind -->
                    </WrapPanel>
                    <TextBlock x:Name="NoChampionshipsText"
                               Text="—"
                               Style="{StaticResource Accolades.Empty}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Previous Seasons -->
                <Grid x:Name="SeasonsBlock" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Accolades.SeasonsHeader}">
                        <TextBlock Text="{loc:Loc DriverAccoladesWindow_PreviousSeasonsLabel}" Style="{StaticResource Accolades.SectionTitle}"/>
                    </Border>

                    <!-- Column headers -->
                    <Grid Grid.Row="1" Style="{StaticResource Accolades.ColumnHeaders}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*" MinWidth="75"/>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Loc DriverAccoladesWindow_YearColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Loc DriverAccoladesWindow_PositionColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="2" Text="{loc:Loc DriverAccoladesWindow_TeamColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="3" Text="{loc:Loc DriverAccoladesWindow_RacesColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="4" Text="{loc:Loc DriverAccoladesWindow_WinsColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="5" Text="{loc:Loc DriverAccoladesWindow_PodiumsColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="6" Text="{loc:Loc DriverAccoladesWindow_PolesColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                        <TextBlock Grid.Column="7" Text="{loc:Loc DriverAccoladesWindow_PointsColumnHeader}" Style="{StaticResource Accolades.ColumnHeader}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  MinHeight="120"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SeasonsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Accolades.SeasonRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*" MinWidth="75"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Year}" Style="{StaticResource Accolades.DriverCell}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Position, StringFormat=\{0\}.}" Style="{StaticResource Accolades.DriverCell}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TeamName}" Style="{StaticResource Accolades.DriverCell}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding TeamName}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Races}" Style="{StaticResource Accolades.DriverCell}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Wins}" Style="{StaticResource Accolades.DriverCell}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Podiums}" Style="{StaticResource Accolades.DriverCell}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Poles}" Style="{StaticResource Accolades.DriverCell}"/>
                                            <TextBlock Grid.Column="7" Text="{Binding Points}" Style="{StaticResource Accolades.DriverCell}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="NoSeasonsText"
                               Grid.Row="2"
                               Text="—"
                               Style="{StaticResource Accolades.Empty}"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
