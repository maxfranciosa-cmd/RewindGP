<!--Historical Standings Window - the standings of a past season; the keys at the bottom select the season-->
<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.Views.HistoricalStandingsWindow"
        Title="{loc:Loc HistoricalStandingsWindow_Title}"
        Height="800" Width="1100"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource HistoricalStandings.WindowBackground}"
        SizeChanged="Window_SizeChanged">

    <!-- This window only holds structure. How each part looks comes from the "HistoricalStandings.*" styles
         of the active visual style (Themes/<style>/HistoricalStandings.xaml); the size of the page text,
         which the code-behind enlarges on a wide window, comes from there too. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource HistoricalStandings.ScrollBar}"/>
    </Window.Resources>

    <Grid x:Name="ScreenRoot" Style="{StaticResource HistoricalStandings.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header (the teletext page number in the retro style) -->
        <Grid Grid.Row="0" Style="{StaticResource HistoricalStandings.PageHeader}">
            <TextBlock Text="P302 REWINDTEXT 302" Style="{StaticResource HistoricalStandings.PageHeaderText}"/>
            <TextBlock Text="302" Style="{StaticResource HistoricalStandings.PageNumber}"/>
        </Grid>

        <!-- Title -->
        <Border Grid.Row="1" Style="{StaticResource HistoricalStandings.TitleBar}">
            <TextBlock x:Name="TitleText"
                       Text="{loc:Loc HistoricalStandingsWindow_Header}"
                       Style="{StaticResource HistoricalStandings.Title}"/>
        </Border>

        <!-- Standings Display -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Driver Standings -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HistoricalStandings.SectionHeader}">
                    <TextBlock Text="{loc:Loc HistoricalStandingsWindow_DriversChampionshipHeader}"
                               Style="{StaticResource HistoricalStandings.SectionTitle}"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoricalDriverStandingsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HistoricalStandings.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Position -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Position}"
                                                   Style="{StaticResource HistoricalStandings.RowPosition}"/>

                                        <!-- Driver Name -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DriverName}"
                                                   Style="{StaticResource HistoricalStandings.RowName}"/>

                                        <!-- Team Name -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TeamName}"
                                                   Style="{StaticResource HistoricalStandings.RowTeam}"/>

                                        <!-- Points -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Points, StringFormat=\{0\}}"
                                                   Style="{StaticResource HistoricalStandings.RowPoints}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Constructor Standings -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HistoricalStandings.SectionHeader}">
                    <TextBlock Text="{loc:Loc HistoricalStandingsWindow_ConstructorsChampionshipHeader}"
                               Style="{StaticResource HistoricalStandings.SectionTitle}"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoricalConstructorStandingsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HistoricalStandings.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Position -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Position}"
                                                   Style="{StaticResource HistoricalStandings.RowPosition}"/>

                                        <!-- Team Name -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TeamName}"
                                                   Style="{StaticResource HistoricalStandings.RowName}"/>

                                        <!-- Points -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Points, StringFormat=\{0\}}"
                                                   Style="{StaticResource HistoricalStandings.RowPoints}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Year Selector -->
        <TextBlock Grid.Row="3"
                   Text="{loc:Loc HistoricalStandingsWindow_SelectSeasonLabel}"
                   Style="{StaticResource HistoricalStandings.SelectSeasonLabel}"/>

        <ItemsControl x:Name="YearSelector" Grid.Row="4" AlternationCount="4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Year}"
                            Tag="{Binding Year}"
                            Style="{StaticResource HistoricalStandings.YearKey}"
                            Click="YearButton_Click"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
