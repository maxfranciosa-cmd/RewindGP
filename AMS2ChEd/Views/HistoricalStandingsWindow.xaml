<!--Historical Standings Window - a teletext page: the coloured keys at the bottom select the season-->
<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.Views.HistoricalStandingsWindow"
        Title="{loc:Loc HistoricalStandingsWindow_Title}"
        Height="800" Width="1100"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#050505"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource TeletextScrollBarStyle}"/>

        <!-- Season key: red, green, yellow, cyan in turn like the coloured buttons of a remote; the selected season is white -->
        <Style x:Key="YearKeyStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#ff3c3c"/>
            <Setter Property="Foreground" Value="#050505"/>
            <Setter Property="Margin" Value="0,0,26,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="1">
                    <Setter Property="Background" Value="{StaticResource TeletextGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="2">
                    <Setter Property="Background" Value="{StaticResource TeletextYellowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="3">
                    <Setter Property="Background" Value="{StaticResource TeletextCyanBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ScreenRoot"
          Margin="36,24,36,20"
          TextElement.FontFamily="{StaticResource FontScreen}"
          TextElement.FontSize="26"
          TextElement.Foreground="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Grid.Row="0">
            <TextBlock Text="P302 REWINDTEXT 302" HorizontalAlignment="Left"/>
            <TextBlock Text="302" Foreground="{StaticResource TeletextCyanBrush}" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Title -->
        <Border Grid.Row="1" Background="{StaticResource TeletextBlueBrush}" Padding="12,2" Margin="0,8,0,14">
            <TextBlock x:Name="TitleText"
                       Text="{loc:Loc HistoricalStandingsWindow_Header}"
                       Foreground="{StaticResource TeletextYellowBrush}"
                       FontSize="46"/>
        </Border>

        <!-- Standings Display -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Driver Standings -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{loc:Loc HistoricalStandingsWindow_DriversChampionshipHeader}"
                           Foreground="{StaticResource TeletextGreenBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoricalDriverStandingsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Position -->
                                    <TextBlock Grid.Column="0" Text="{Binding Position}"/>

                                    <!-- Driver Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DriverName}"
                                               Foreground="{StaticResource TeletextYellowBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Team Name -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TeamName}"
                                               Foreground="{StaticResource TeletextCyanBrush}"
                                               Margin="10,0"/>

                                    <!-- Points -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Points, StringFormat=\{0\}}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Constructor Standings -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{loc:Loc HistoricalStandingsWindow_ConstructorsChampionshipHeader}"
                           Foreground="{StaticResource TeletextGreenBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoricalConstructorStandingsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Position -->
                                    <TextBlock Grid.Column="0" Text="{Binding Position}"/>

                                    <!-- Team Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TeamName}"
                                               Foreground="{StaticResource TeletextYellowBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Points -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Points, StringFormat=\{0\}}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Year Selector -->
        <TextBlock Grid.Row="3"
                   Text="{loc:Loc HistoricalStandingsWindow_SelectSeasonLabel}"
                   Foreground="{StaticResource TeletextMagentaBrush}"
                   Margin="0,14,0,8"/>

        <ItemsControl x:Name="YearSelector" Grid.Row="4" AlternationCount="4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Year}"
                            Tag="{Binding Year}"
                            Style="{StaticResource YearKeyStyle}"
                            Click="YearButton_Click"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
