<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.SeasonOverviewWindow"
        Title="{loc:Loc SeasonOverviewWindow_Title}"
        Height="900" Width="1200"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BoardBrush}"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PaperScrollBarStyle}"/>

        <Style x:Key="SheetHeaderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- One typed line of a standings sheet; the player's own line is run over with a highlighter -->
        <Style x:Key="SheetRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- A label and its value on the season pass -->
        <Style x:Key="PassRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <!-- A board with the season's paperwork: the player's pass, the next race ticket and the standings sheets -->
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PassColumn" Width="300"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: season pass and notes -->
        <StackPanel Grid.Column="0">

            <!-- Season pass -->
            <Border Style="{StaticResource PaperCardStyle}" Padding="0">
                <StackPanel>
                    <Border Background="{StaticResource StampRedBrush}" Padding="12,9">
                        <TextBlock x:Name="SeasonText"
                                   FontFamily="{StaticResource FontPrint}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Player Photo -->
                    <!-- portrait frame, same 80:114 proportions as the driver portraits -->
                    <Border Width="154" Height="220" Margin="14,14,14,0" HorizontalAlignment="Center" Background="{StaticResource PhotoBackBrush}" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="PlayerPhotoPlaceholder"
                                       Text="?"
                                       FontSize="48"
                                       FontWeight="Bold"
                                       Foreground="#5e666e"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <Image x:Name="PlayerPhotoImage"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Player Name -->
                    <TextBlock x:Name="PlayerNameText"
                               Style="{StaticResource PosterTextStyle}"
                               FontSize="30"
                               TextWrapping="Wrap"
                               Margin="14,10,14,4"/>

                    <StackPanel Margin="14,4,14,4">
                        <!-- Player Team -->
                        <Grid Style="{StaticResource PassRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc SeasonOverviewWindow_TeamLabel}" Style="{StaticResource TypedLabelStyle}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" x:Name="PlayerTeamText" Style="{StaticResource TypedTextStyle}" TextWrapping="Wrap" TextAlignment="Right"/>
                        </Grid>

                        <!-- Player Team Role + Reprimands -->
                        <Grid x:Name="PlayerRoleRow" Style="{StaticResource PassRowStyle}" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc SeasonOverviewWindow_RoleLabel}" Style="{StaticResource TypedLabelStyle}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" x:Name="PlayerRoleText" Style="{StaticResource TypedTextStyle}" TextWrapping="Wrap" TextAlignment="Right"/>
                        </Grid>

                        <!-- Player Reputation -->
                        <Grid Style="{StaticResource PassRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc SeasonOverviewWindow_ReputationLabel}" Style="{StaticResource TypedLabelStyle}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" x:Name="PlayerReputationText" Style="{StaticResource TypedTextStyle}" TextWrapping="Wrap" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Edit Button -->
                    <Button x:Name="EditPlayerButton"
                            Click="EditPlayerButton_Click"
                            Style="{StaticResource HandLinkButtonStyle}"
                            Content="{loc:Loc SeasonOverviewWindow_EditDetailsButton}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12"/>
                </StackPanel>
            </Border>

            <!-- Sticky note: install an improvement package -->
            <Button x:Name="InstallPackageButton"
                    Click="InstallPackageButton_Click"
                    Style="{StaticResource PostItButtonStyle}"
                    Margin="0,24,0,0"
                    ToolTipService.ShowOnDisabled="True"
                    Visibility="Collapsed"/>

            <!-- Improvement packages of every team -->
            <Button x:Name="ImprovementPackagesButton"
                    Click="ImprovementPackagesButton_Click"
                    Style="{StaticResource ManilaButtonStyle}"
                    Content="{loc:Loc SeasonOverviewWindow_ImprovementPackagesTooltip}"
                    Margin="0,24,0,0"/>

            <!-- Past seasons -->
            <Button x:Name="HistoricalStandingsButton"
                    Click="HistoricalStandingsButton_Click"
                    Style="{StaticResource ManilaButtonStyle}"
                    Content="{loc:Loc SeasonOverviewWindow_HistoricalStandingsTooltip}"
                    Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Right: next race ticket and standings sheets -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Next Race ticket -->
            <Border Grid.Row="0" Style="{StaticResource PaperCardStyle}" Background="{StaticResource TicketBrush}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Race Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,20">
                        <TextBlock Text="{loc:Loc SeasonOverviewWindow_NextGrandPrixLabel}" Style="{StaticResource TypedTextStyle}"/>
                        <TextBlock x:Name="NextGPText"
                                   FontFamily="{StaticResource FontPoster}"
                                   FontSize="52"
                                   Foreground="{StaticResource StampRedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,6"/>
                        <TextBlock x:Name="RaceInfoText" Style="{StaticResource TypedTextStyle}"/>
                    </StackPanel>

                    <!-- Perforation -->
                    <Line Grid.Column="1" Y2="1" Stretch="Fill" Stroke="{StaticResource InkFaintBrush}" StrokeThickness="3" StrokeDashArray="2 2"/>

                    <!-- Action Button -->
                    <Button x:Name="NextButton"
                            Grid.Column="2"
                            Click="NextButton_Click"
                            Style="{StaticResource StampButtonStyle}"
                            Content="{loc:Loc SeasonOverviewWindow_ProceedButton}"
                            Margin="30,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Standings sheets -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="CalendarGapColumn" Width="0"/>
                    <ColumnDefinition x:Name="CalendarColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Driver Standings -->
                <Border Grid.Column="0" Style="{StaticResource PaperCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource SheetHeaderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc SeasonOverviewWindow_DriverStandingsHeader}"
                                           Style="{StaticResource TypedTextStyle}"
                                           FontSize="21"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Bottom"/>

                                <!-- Grid View Button -->
                                <Button x:Name="DriverGridButton"
                                        Grid.Row="1"
                                        Margin="0,2,0,0"
                                        Click="DriverGridButton_Click"
                                        Style="{StaticResource HandLinkButtonStyle}"
                                        Content="{loc:Loc SeasonOverviewWindow_GridViewTooltip}"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Standings List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DriverStandingsItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MouseLeftButtonDown="DriverRow_MouseDoubleClick">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SheetRowStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource HighlighterBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Position -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Position, StringFormat=\{0\}.}"
                                                           Style="{StaticResource TypedTextStyle}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Race number in team colour -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding BadgeColor}"
                                                        Width="28" Height="20"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RaceNumber}"
                                                               Foreground="{Binding BadgeTextColor}"
                                                               FontFamily="{StaticResource FontPrint}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Driver Name -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DriverName}"
                                                           Style="{StaticResource TypedTextStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>

                                                <!-- Points -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Points}"
                                                           Style="{StaticResource TypedTextStyle}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Constructor Standings -->
                <Border Grid.Column="2" Style="{StaticResource PaperCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource SheetHeaderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc SeasonOverviewWindow_ConstructorStandingsHeader}"
                                           Style="{StaticResource TypedTextStyle}"
                                           FontSize="21"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Bottom"/>

                                <!-- Grid View Button -->
                                <Button x:Name="ConstructorGridButton"
                                        Grid.Row="1"
                                        Margin="0,2,0,0"
                                        Click="ConstructorGridButton_Click"
                                        Style="{StaticResource HandLinkButtonStyle}"
                                        Content="{loc:Loc SeasonOverviewWindow_GridViewTooltip}"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Standings List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ConstructorStandingsItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MouseLeftButtonDown="ConstructorRow_MouseDoubleClick">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SheetRowStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayerTeam}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource HighlighterBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Position -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Position, StringFormat=\{0\}.}"
                                                           Style="{StaticResource TypedTextStyle}"
                                                           VerticalAlignment="Center"/>

                                                <!-- Team Color -->
                                                <Rectangle Grid.Column="1"
                                                           Width="12" Height="12"
                                                           Fill="{Binding TeamColor}"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"/>

                                                <!-- Team Name -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TeamName}"
                                                           Style="{StaticResource TypedTextStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>

                                                <!-- Points -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Points}"
                                                           Style="{StaticResource TypedTextStyle}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Calendar sheet, only when the window is wide enough -->
                <Border x:Name="CalendarSheet" Grid.Column="4" Style="{StaticResource PaperCardStyle}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SheetHeaderStyle}">
                            <TextBlock Text="{loc:Loc SeasonOverviewWindow_CalendarHeader}"
                                       Style="{StaticResource TypedTextStyle}"
                                       FontSize="21"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CalendarItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="2,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource HighlighterBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Round, StringFormat=\{0\}.}" Style="{StaticResource TypedTextStyle}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RaceName}" Style="{StaticResource TypedTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedDate}" Style="{StaticResource TypedLabelStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
