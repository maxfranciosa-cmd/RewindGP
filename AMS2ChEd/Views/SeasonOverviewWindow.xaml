<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        mc:Ignorable="d"
        x:Class="AMS2ChEd.SeasonOverviewWindow"
        Title="{loc:Loc SeasonOverviewWindow_Title}"
        Height="900" Width="1200"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SeasonOverview.WindowBackground}"
        SizeChanged="Window_SizeChanged">

    <!-- This window only holds structure. How each part looks comes from the "SeasonOverview.*" styles
         of the active visual style (Themes/<style>/SeasonOverview.xaml), so nothing here sets a colour,
         a font or a spacing. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SeasonOverview.ScrollBar}"/>
    </Window.Resources>

    <!-- The player's card on the left; the next race and the standings on the right -->
    <Grid Style="{StaticResource SeasonOverview.Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PassColumn" Width="300"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: player card and navigation -->
        <StackPanel Grid.Column="0">

            <!-- Player card -->
            <Border Style="{StaticResource SeasonOverview.PassCard}">
                <StackPanel>
                    <Border Style="{StaticResource SeasonOverview.SeasonBanner}">
                        <TextBlock x:Name="SeasonText" Style="{StaticResource SeasonOverview.SeasonBannerText}"/>
                    </Border>

                    <!-- Player Photo -->
                    <Border Style="{StaticResource SeasonOverview.Photo}">
                        <Grid>
                            <TextBlock x:Name="PlayerPhotoPlaceholder"
                                       Text="?"
                                       Style="{StaticResource SeasonOverview.PhotoPlaceholder}"
                                       Visibility="Collapsed"/>
                            <Image x:Name="PlayerPhotoImage"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Player Name -->
                    <TextBlock x:Name="PlayerNameText" Style="{StaticResource SeasonOverview.PlayerName}"/>

                    <StackPanel Style="{StaticResource SeasonOverview.PassRows}">
                        <!-- Player Team -->
                        <Grid Style="{StaticResource SeasonOverview.PassRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc SeasonOverviewWindow_TeamLabel}" Style="{StaticResource SeasonOverview.PassLabel}"/>
                            <TextBlock Grid.Column="1" x:Name="PlayerTeamText" Style="{StaticResource SeasonOverview.PassValue}"/>
                        </Grid>

                        <!-- Player Team Role + Reprimands -->
                        <Grid x:Name="PlayerRoleRow" Style="{StaticResource SeasonOverview.PassRow}" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc SeasonOverviewWindow_RoleLabel}" Style="{StaticResource SeasonOverview.PassLabel}"/>
                            <TextBlock Grid.Column="1" x:Name="PlayerRoleText" Style="{StaticResource SeasonOverview.PassValue}"/>
                        </Grid>

                        <!-- Player Reputation -->
                        <Grid Style="{StaticResource SeasonOverview.PassRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Loc SeasonOverviewWindow_ReputationLabel}" Style="{StaticResource SeasonOverview.PassLabel}"/>
                            <TextBlock Grid.Column="1" x:Name="PlayerReputationText" Style="{StaticResource SeasonOverview.PassValue}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Edit Button -->
                    <Button x:Name="EditPlayerButton"
                            Click="EditPlayerButton_Click"
                            Style="{StaticResource SeasonOverview.EditButton}"
                            Content="{loc:Loc SeasonOverviewWindow_EditDetailsButton}"/>
                </StackPanel>
            </Border>

            <!-- Install an improvement package -->
            <Button x:Name="InstallPackageButton"
                    Click="InstallPackageButton_Click"
                    Style="{StaticResource SeasonOverview.InstallPackageButton}"
                    ToolTipService.ShowOnDisabled="True"
                    Visibility="Collapsed"/>

            <!-- Improvement packages of every team -->
            <Button x:Name="ImprovementPackagesButton"
                    Click="ImprovementPackagesButton_Click"
                    Style="{StaticResource SeasonOverview.ImprovementPackagesButton}"
                    Content="{loc:Loc SeasonOverviewWindow_ImprovementPackagesTooltip}"/>

            <!-- Past seasons -->
            <Button x:Name="HistoricalStandingsButton"
                    Click="HistoricalStandingsButton_Click"
                    Style="{StaticResource SeasonOverview.HistoricalStandingsButton}"
                    Content="{loc:Loc SeasonOverviewWindow_HistoricalStandingsTooltip}"/>
        </StackPanel>

        <!-- Right: next race and standings -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Next Race -->
            <Border Grid.Row="0" Style="{StaticResource SeasonOverview.NextRaceCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Race Info -->
                    <StackPanel Grid.Column="0" Style="{StaticResource SeasonOverview.NextRaceInfo}">
                        <TextBlock Text="{loc:Loc SeasonOverviewWindow_NextGrandPrixLabel}" Style="{StaticResource SeasonOverview.NextRaceLabel}"/>
                        <TextBlock x:Name="NextGPText" Style="{StaticResource SeasonOverview.NextRaceName}"/>
                        <TextBlock x:Name="RaceInfoText" Style="{StaticResource SeasonOverview.NextRaceDetails}"/>
                    </StackPanel>

                    <!-- Divider between the race and its action (a ticket perforation in the retro style) -->
                    <Line Grid.Column="1" Y2="1" Stretch="Fill" Style="{StaticResource SeasonOverview.Perforation}"/>

                    <!-- Action Button -->
                    <Button x:Name="NextButton"
                            Grid.Column="2"
                            Click="NextButton_Click"
                            Style="{StaticResource SeasonOverview.ProceedButton}"
                            Content="{loc:Loc SeasonOverviewWindow_ProceedButton}"/>
                </Grid>
            </Border>

            <!-- Standings -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="CalendarGapColumn" Width="0"/>
                    <ColumnDefinition x:Name="CalendarColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Driver Standings -->
                <Border Grid.Column="0" Style="{StaticResource SeasonOverview.SheetCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header: the style decides whether the grid view link sits beside or under the title -->
                        <Border Grid.Row="0" Style="{StaticResource SeasonOverview.SheetHeader}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc SeasonOverviewWindow_DriverStandingsHeader}"
                                           Style="{StaticResource SeasonOverview.SheetTitle}"/>

                                <!-- Grid View Button -->
                                <Button x:Name="DriverGridButton"
                                        Click="DriverGridButton_Click"
                                        Style="{StaticResource SeasonOverview.SheetLinkButton}"
                                        Content="{loc:Loc SeasonOverviewWindow_GridViewTooltip}"/>
                            </Grid>
                        </Border>

                        <!-- Standings List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DriverStandingsItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MouseLeftButtonDown="DriverRow_MouseDoubleClick">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SeasonOverview.SheetRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SeasonOverview.HighlightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Position -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Position, StringFormat=\{0\}.}"
                                                           Style="{StaticResource SeasonOverview.RowPosition}"/>

                                                <!-- Race number in team colour -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding BadgeColor}"
                                                        Style="{StaticResource SeasonOverview.NumberBadge}">
                                                    <TextBlock Text="{Binding RaceNumber}"
                                                               Foreground="{Binding BadgeTextColor}"
                                                               Style="{StaticResource SeasonOverview.NumberBadgeText}"/>
                                                </Border>

                                                <!-- Driver Name -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DriverName}"
                                                           Style="{StaticResource SeasonOverview.RowName}"/>

                                                <!-- Points -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Points}"
                                                           Style="{StaticResource SeasonOverview.RowPoints}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Constructor Standings -->
                <Border Grid.Column="2" Style="{StaticResource SeasonOverview.SheetCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Style="{StaticResource SeasonOverview.SheetHeader}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc SeasonOverviewWindow_ConstructorStandingsHeader}"
                                           Style="{StaticResource SeasonOverview.SheetTitle}"/>

                                <!-- Grid View Button -->
                                <Button x:Name="ConstructorGridButton"
                                        Click="ConstructorGridButton_Click"
                                        Style="{StaticResource SeasonOverview.SheetLinkButton}"
                                        Content="{loc:Loc SeasonOverviewWindow_GridViewTooltip}"/>
                            </Grid>
                        </Border>

                        <!-- Standings List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ConstructorStandingsItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MouseLeftButtonDown="ConstructorRow_MouseDoubleClick">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SeasonOverview.SheetRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayerTeam}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SeasonOverview.HighlightBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Position -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Position, StringFormat=\{0\}.}"
                                                           Style="{StaticResource SeasonOverview.RowPosition}"/>

                                                <!-- Team Color -->
                                                <Rectangle Grid.Column="1"
                                                           Fill="{Binding TeamColor}"
                                                           Style="{StaticResource SeasonOverview.TeamSwatch}"/>

                                                <!-- Team Name -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TeamName}"
                                                           Style="{StaticResource SeasonOverview.RowName}"/>

                                                <!-- Points -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Points}"
                                                           Style="{StaticResource SeasonOverview.RowPoints}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Calendar, only when the window is wide enough -->
                <Border x:Name="CalendarSheet" Grid.Column="4" Style="{StaticResource SeasonOverview.SheetCard}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SeasonOverview.SheetHeader}">
                            <TextBlock Text="{loc:Loc SeasonOverviewWindow_CalendarHeader}"
                                       Style="{StaticResource SeasonOverview.SheetTitle}"/>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CalendarItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SeasonOverview.CalendarRow}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SeasonOverview.HighlightBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Round, StringFormat=\{0\}.}" Style="{StaticResource SeasonOverview.RowPosition}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RaceName}" Style="{StaticResource SeasonOverview.RowName}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedDate}" Style="{StaticResource SeasonOverview.RowDetail}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
