<Window x:Class="AMS2ChEd.Views.ImprovementPackagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        Title="{loc:Loc ImprovementPackagesWindow_Title}"
        Height="800" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ImprovementPackages.WindowBackground}"
        ResizeMode="CanResize">

    <!-- This window only holds structure. How each part looks comes from the "ImprovementPackages.*" styles
         of the active visual style (Themes/<style>/ImprovementPackages.xaml); the table cells built in the
         code-behind take theirs from there too. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ImprovementPackages.ScrollBar}"/>
    </Window.Resources>

    <Border Style="{StaticResource ImprovementPackages.Frame}">
        <Grid Style="{StaticResource ImprovementPackages.Root}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: the style decides which of the rules around the title are drawn -->
            <StackPanel Grid.Row="0" Style="{StaticResource ImprovementPackages.Header}">
                <Rectangle Style="{StaticResource ImprovementPackages.TopRuleOuter}"/>
                <Rectangle Style="{StaticResource ImprovementPackages.TopRuleInner}"/>

                <TextBlock Text="{loc:Loc ImprovementPackagesWindow_Header}"
                           Style="{StaticResource ImprovementPackages.Title}"/>

                <TextBlock x:Name="SeasonYearText"
                           Style="{StaticResource ImprovementPackages.Subtitle}"/>

                <Rectangle Style="{StaticResource ImprovementPackages.BottomRuleInner}"/>
                <Rectangle Style="{StaticResource ImprovementPackages.BottomRuleOuter}"/>
            </StackPanel>

            <!-- Scrollable content -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ImprovementPackages.TableArea}">
                <Border Style="{StaticResource ImprovementPackages.Table}">
                    <Grid x:Name="TeamsGrid">
                        <!-- Teams will be populated dynamically -->
                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="2">
                <Rectangle Style="{StaticResource ImprovementPackages.FooterRule}"/>
                <TextBlock Text="{loc:Loc ImprovementPackagesWindow_FooterText}"
                           Style="{StaticResource ImprovementPackages.FooterText}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
