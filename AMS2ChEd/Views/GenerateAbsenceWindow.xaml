<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AMS2ChEd.GenerateAbsenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AMS2ChEd.Localization"
        Title="{loc:Loc GenerateAbsenceWindow_WindowTitle}"
        Height="700" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Charcoal.BackgroundBrush}"
        ResizeMode="NoResize">

    <!-- A utility window: it wears the charcoal look ("Charcoal.*" resources of Themes/Charcoal/Base.xaml)
         whatever the visual style. -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Charcoal.TitleBarStyle}">
            <TextBlock x:Name="TitleText"
                       Text="{loc:Loc GenerateAbsenceWindow_PayDriverTitle}"
                       Style="{StaticResource Charcoal.TitleTextStyle}"/>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Style="{StaticResource Charcoal.PanelStyle}" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Charcoal.BodyTextStyle}"
                               Foreground="{StaticResource Charcoal.TextSoftBrush}"
                               TextWrapping="Wrap"
                               LineHeight="26"
                               TextAlignment="Left">
                        <Run x:Name="IntroText1" Text="{loc:Loc GenerateAbsenceWindow_PayDriver_Intro1}"/>
                        <LineBreak/><LineBreak/>
                        <Run x:Name="IntroText2" Text="{loc:Loc GenerateAbsenceWindow_PayDriver_Intro2}"/>
                        <LineBreak/><LineBreak/>
                        <Run x:Name="IntroText3" Text="{loc:Loc GenerateAbsenceWindow_Intro3}"/>
                        <LineBreak/><LineBreak/>
                        <Run x:Name="QuestionText" FontWeight="Bold" Foreground="{StaticResource Charcoal.TextBrush}" Text="{loc:Loc GenerateAbsenceWindow_QuestionText}"/>
                        <LineBreak/><LineBreak/>
                        <Run FontStyle="Italic" Foreground="{StaticResource Charcoal.TextMutedBrush}" Text="{loc:Loc GenerateAbsenceWindow_FooterNote}"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="YesButton"
                    Content="{loc:Loc GenerateAbsenceWindow_YesButton}"
                    Style="{StaticResource Charcoal.DialogPrimaryButtonStyle}"
                    Click="YesButton_Click"/>
            <Button x:Name="NoButton"
                    Content="{loc:Loc GenerateAbsenceWindow_NoButton}"
                    Style="{StaticResource Charcoal.DialogSecondaryButtonStyle}"
                    Margin="2,0,0,0"
                    Click="NoButton_Click"/>
            <Button x:Name="BackButton"
                    Content="{loc:Loc GenerateAbsenceWindow_BackButton}"
                    Style="{StaticResource Charcoal.DialogSecondaryButtonStyle}"
                    Margin="2,0,0,0" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
