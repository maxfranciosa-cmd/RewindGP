<Window x:Class="Ams2ChEd.Business.AMS2.UI.Ams2PlayerCosmeticsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:loc="clr-namespace:Ams2ChEd.Business.AMS2.Localization"
        Title="{loc:Loc Ams2PlayerCosmeticsEditorWindow_Title}"
        Height="750" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Charcoal.BackgroundBrush}"
        ResizeMode="NoResize">

    <!-- A utility window: it wears the charcoal look whatever the visual style. The "Charcoal.*" resources
         are not defined in this project: the host application provides them in its application resources
         (Themes/Charcoal/Base.xaml, merged by its App.xaml). -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

        <Style x:Key="InputTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource Charcoal.TextBoxStyle}"/>

        <!-- the caption above a field -->
        <Style x:Key="InputLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- the hint under a caption -->
        <Style x:Key="HelpTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Charcoal.TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- a caption inside a helmet tab -->
        <Style x:Key="SubLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource InputLabelStyle}">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Charcoal.DialogSecondaryButtonStyle}"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Charcoal.DialogPrimaryButtonStyle}"/>

        <!-- sits against the end of the field it fills in -->
        <Style x:Key="BrowseButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource Charcoal.DialogSecondaryButtonStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>

        <Style x:Key="RadioButtonStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Charcoal.RadioButtonStyle}">
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>

        <Style x:Key="EraTabControlStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource Charcoal.TabControlStyle}"/>

        <Style x:Key="EraTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource Charcoal.TabItemStyle}"/>

        <!-- One helmet design; the chosen one is outlined in red -->
        <DataTemplate x:Key="HelmetItemTemplate">
            <Border Width="100"
                    Height="120"
                    Margin="0,0,8,8"
                    BorderThickness="3"
                    Cursor="Hand"
                    MouseLeftButtonDown="HelmetPreview_Click"
                    Tag="{Binding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Charcoal.StripHoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Charcoal.StripHoverBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Charcoal.TextMutedBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Charcoal.RedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Image Source="{Binding HelmetDesign.PreviewImage}"
                           Stretch="UniformToFill"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource Charcoal.TitleBarStyle}">
                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_Header}" Style="{StaticResource Charcoal.TitleTextStyle}"/>
            </Border>

            <!-- Form Content -->
            <Border Grid.Row="1" Style="{StaticResource Charcoal.PanelStyle}" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Player Name -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_PlayerNameLabel}" Style="{StaticResource InputLabelStyle}"/>
                        <TextBox x:Name="PlayerNameTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 MaxLength="50"/>
                    </StackPanel>

                    <!-- Nationality -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_NationalityLabel}" Style="{StaticResource InputLabelStyle}"/>
                        <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_NationalityHelp}"
                                   Style="{StaticResource HelpTextStyle}"/>
                        <TextBox x:Name="NationalityTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 MaxLength="3"
                                 CharacterCasing="Upper"/>
                    </StackPanel>

                    <!-- Photo File -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_PhotoFileLabel}" Style="{StaticResource InputLabelStyle}"/>
                        <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_PhotoFileHelp}"
                                   Style="{StaticResource HelpTextStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PhotoFileTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     IsReadOnly="True"/>
                            <Button Grid.Column="1"
                                    x:Name="BrowsePhotoButton"
                                    Click="BrowsePhotoButton_Click"
                                    Style="{StaticResource BrowseButtonStyle}"
                                    Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Photo URL -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_PhotoUrlLabel}" Style="{StaticResource InputLabelStyle}"/>
                        <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_PhotoUrlHelp}"
                                   Style="{StaticResource HelpTextStyle}"/>
                        <TextBox x:Name="PhotoURLTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 MaxLength="500"/>
                    </StackPanel>

                    <!-- Helmet Design Section -->
                    <Border Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_HelmetDesignLabel}"
                                       Style="{StaticResource Charcoal.HeadingTextStyle}"
                                       FontSize="19"
                                       Margin="0,0,0,10"/>

                            <!-- Era Tabs -->
                            <TabControl x:Name="EraTabControl"
                                        Style="{StaticResource EraTabControlStyle}"
                                        SelectionChanged="EraTabControl_SelectionChanged">

                                <!-- ═══ MODERN TAB ═══ -->
                                <TabItem Header="{loc:Loc Ams2PlayerCosmeticsEditorWindow_ModernTab}" Style="{StaticResource EraTabItemStyle}" Tag="Modern">
                                    <StackPanel Margin="0,15,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <RadioButton x:Name="UseDefaultHelmetRadio_Modern"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseDefaultHelmetOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_Modern"
                                                         IsChecked="True"
                                                         Checked="HelmetModeChanged_Modern"/>
                                            <RadioButton x:Name="UseCustomHelmetRadio_Modern"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseCustomFilesOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_Modern"
                                                         Checked="HelmetModeChanged_Modern"/>
                                        </StackPanel>

                                        <!-- Default Helmets -->
                                        <StackPanel x:Name="DefaultHelmetPanel_Modern" Visibility="Visible">
                                            <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_SelectHelmetDesignLabel}"
                                                       Style="{StaticResource SubLabelStyle}" Margin="0,0,0,10"/>
                                            <ItemsControl x:Name="DefaultHelmetItemsControl_Modern"
                                                          ItemTemplate="{StaticResource HelmetItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Custom Files -->
                                        <StackPanel x:Name="CustomHelmetPanel_Modern" Visibility="Collapsed">
                                            <StackPanel Margin="0,0,0,15">
                                                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_HelmetFileLabel}" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="HelmetFileTextBox_Modern" Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Click="BrowseHelmetButton_Click"
                                                            Style="{StaticResource BrowseButtonStyle}" Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}" Tag="Modern"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_VisorFileLabel}" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="VisorFileTextBox_Modern" Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Click="BrowseVisorButton_Click"
                                                            Style="{StaticResource BrowseButtonStyle}" Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}" Tag="Modern"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <!-- ═══ 1990s TAB ═══ -->
                                <TabItem Header="{loc:Loc Ams2PlayerCosmeticsEditorWindow_NinetiesTab}" Style="{StaticResource EraTabItemStyle}" Tag="Nineties">
                                    <StackPanel Margin="0,15,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <RadioButton x:Name="UseDefaultHelmetRadio_90s"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseDefaultHelmetOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_90s"
                                                         IsChecked="True"
                                                         Checked="HelmetModeChanged_90s"/>
                                            <RadioButton x:Name="UseCustomHelmetRadio_90s"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseCustomFilesOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_90s"
                                                         Checked="HelmetModeChanged_90s"/>
                                        </StackPanel>

                                        <!-- Default Helmets -->
                                        <StackPanel x:Name="DefaultHelmetPanel_90s" Visibility="Visible">
                                            <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_SelectHelmetDesignLabel}"
                                                       Style="{StaticResource SubLabelStyle}" Margin="0,0,0,10"/>
                                            <ItemsControl x:Name="DefaultHelmetItemsControl_90s"
                                                          ItemTemplate="{StaticResource HelmetItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Custom Files (90s only has helmet, no visor) -->
                                        <StackPanel x:Name="CustomHelmetPanel_90s" Visibility="Collapsed">
                                            <StackPanel Margin="0,0,0,15">
                                                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_HelmetFileLabel}" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="HelmetFileTextBox_90s" Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Click="BrowseHelmetButton_Click"
                                                            Style="{StaticResource BrowseButtonStyle}" Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}" Tag="Nineties"/>
                                                </Grid>
                                            </StackPanel>
                                            <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_NinetiesNoVisorNote}"
                                                       Style="{StaticResource HelpTextStyle}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <!-- ═══ 1980s TAB ═══ -->
                                <TabItem Header="{loc:Loc Ams2PlayerCosmeticsEditorWindow_EightiesTab}" Style="{StaticResource EraTabItemStyle}" Tag="Eighties">
                                    <StackPanel Margin="0,15,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <RadioButton x:Name="UseDefaultHelmetRadio_80s"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseDefaultHelmetOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_80s"
                                                         IsChecked="True"
                                                         Checked="HelmetModeChanged_80s"/>
                                            <RadioButton x:Name="UseCustomHelmetRadio_80s"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseCustomFilesOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_80s"
                                                         Checked="HelmetModeChanged_80s"/>
                                        </StackPanel>

                                        <!-- Default Helmets -->
                                        <StackPanel x:Name="DefaultHelmetPanel_80s" Visibility="Visible">
                                            <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_SelectHelmetDesignLabel}"
                                                       Style="{StaticResource SubLabelStyle}" Margin="0,0,0,10"/>
                                            <ItemsControl x:Name="DefaultHelmetItemsControl_80s"
                                                          ItemTemplate="{StaticResource HelmetItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Custom Files -->
                                        <StackPanel x:Name="CustomHelmetPanel_80s" Visibility="Collapsed">
                                            <StackPanel Margin="0,0,0,15">
                                                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_HelmetFileLabel}" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="HelmetFileTextBox_80s" Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Click="BrowseHelmetButton_Click"
                                                            Style="{StaticResource BrowseButtonStyle}" Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}" Tag="Eighties"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_VisorFileLabel}" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="VisorFileTextBox_80s" Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Click="BrowseVisorButton_Click"
                                                            Style="{StaticResource BrowseButtonStyle}" Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}" Tag="Eighties"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <!-- ═══ 1970s TAB ═══ -->
                                <TabItem Header="{loc:Loc Ams2PlayerCosmeticsEditorWindow_SeventiesTab}" Style="{StaticResource EraTabItemStyle}" Tag="Seventies">
                                    <StackPanel Margin="0,15,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <RadioButton x:Name="UseDefaultHelmetRadio_70s"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseDefaultHelmetOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_70s"
                                                         IsChecked="True"
                                                         Checked="HelmetModeChanged_70s"/>
                                            <RadioButton x:Name="UseCustomHelmetRadio_70s"
                                                         Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_UseCustomFilesOption}"
                                                         Style="{StaticResource RadioButtonStyle}"
                                                         GroupName="HelmetMode_70s"
                                                         Checked="HelmetModeChanged_70s"/>
                                        </StackPanel>

                                        <!-- Default Helmets -->
                                        <StackPanel x:Name="DefaultHelmetPanel_70s" Visibility="Visible">
                                            <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_SelectHelmetDesignLabel}"
                                                       Style="{StaticResource SubLabelStyle}" Margin="0,0,0,10"/>
                                            <ItemsControl x:Name="DefaultHelmetItemsControl_70s"
                                                          ItemTemplate="{StaticResource HelmetItemTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Custom Files -->
                                        <StackPanel x:Name="CustomHelmetPanel_70s" Visibility="Collapsed">
                                            <StackPanel Margin="0,0,0,15">
                                                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_HelmetFileLabel}" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="HelmetFileTextBox_70s" Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Click="BrowseHelmetButton_Click"
                                                            Style="{StaticResource BrowseButtonStyle}" Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}" Tag="Seventies"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Ams2PlayerCosmeticsEditorWindow_VisorFileLabel}" Style="{StaticResource SubLabelStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="VisorFileTextBox_70s" Grid.Column="0"
                                                             Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>
                                                    <Button Grid.Column="1" Click="BrowseVisorButton_Click"
                                                            Style="{StaticResource BrowseButtonStyle}" Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_BrowseButton}" Tag="Seventies"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                            </TabControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            </Border>

            <!-- Action Buttons -->
            <Border Grid.Row="2" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Style="{StaticResource DialogButtonStyle}"
                            Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_CancelButton}"/>

                    <Button Grid.Column="3"
                            x:Name="SaveButton"
                            Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{loc:Loc Ams2PlayerCosmeticsEditorWindow_SaveButton}"/>
                </Grid>
            </Border>
    </Grid>
</Window>
