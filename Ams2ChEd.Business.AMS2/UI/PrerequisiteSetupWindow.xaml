<Window x:Class="Ams2ChEd.Business.AMS2.UI.PrerequisiteSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ams2ChEd.Business.AMS2.Localization"
        Title="{loc:Loc PrerequisiteSetupWindow_Title}"
        Height="530" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Charcoal.BackgroundBrush}"
        ResizeMode="NoResize">

    <!-- A utility window: it wears the charcoal look whatever the visual style. The "Charcoal.*" resources
         are not defined in this project: the host application provides them in its application resources
         (Themes/Charcoal/Base.xaml, merged by its App.xaml). -->
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Charcoal.ScrollBarStyle}"/>

        <Style x:Key="StepHeader" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.HeadingTextStyle}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource Charcoal.BodyTextStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Charcoal.TextSoftBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Charcoal.TitleBarStyle}">
            <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Header}" Style="{StaticResource Charcoal.TitleTextStyle}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Charcoal.PanelStyle}" Margin="0,14,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Intro}" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step1Header}" Style="{StaticResource StepHeader}"/>
                    <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step1Body}" Style="{StaticResource BodyText}"/>
                    <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step2Header}" Style="{StaticResource StepHeader}"/>
                    <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step2Body}" Style="{StaticResource BodyText}" Margin="0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <CheckBox x:Name="DontShowAgainCheckBox"
                      Content="{loc:Loc PrerequisiteSetupWindow_DontShowAgain}"
                      Style="{StaticResource Charcoal.CheckBoxStyle}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"/>

            <Button Content="{loc:Loc PrerequisiteSetupWindow_GotItButton}"
                    Style="{StaticResource Charcoal.DialogPrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="OkButton_Click"/>
        </Grid>
    </Grid>
</Window>
