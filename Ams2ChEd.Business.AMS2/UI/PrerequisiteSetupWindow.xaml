<Window x:Class="Ams2ChEd.Business.AMS2.UI.PrerequisiteSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ams2ChEd.Business.AMS2.Localization"
        Title="{loc:Loc PrerequisiteSetupWindow_Title}"
        Height="530" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#c41e3a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d32f2f"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc PrerequisiteSetupWindow_Header}"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Intro}" Foreground="#cccccc" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15"/>
            <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step1Header}" Foreground="White" FontSize="14" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step1Body}" Foreground="#cccccc" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15"/>
            <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step2Header}" Foreground="White" FontSize="14" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="{loc:Loc PrerequisiteSetupWindow_Step2Body}" Foreground="#cccccc" FontSize="13" TextWrapping="Wrap"/>
        </StackPanel>

        <CheckBox x:Name="DontShowAgainCheckBox"
                  Grid.Row="2"
                  Content="{loc:Loc PrerequisiteSetupWindow_DontShowAgain}"
                  Foreground="#cccccc"
                  FontSize="13"
                  Margin="0,15,0,10"/>

        <Button Grid.Row="3"
                Content="{loc:Loc PrerequisiteSetupWindow_GotItButton}"
                Width="150"
                HorizontalAlignment="Center"
                Style="{StaticResource MenuButtonStyle}"
                Click="OkButton_Click"/>
    </Grid>
</Window>
