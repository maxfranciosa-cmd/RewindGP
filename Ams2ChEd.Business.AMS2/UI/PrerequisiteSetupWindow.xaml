<Window x:Class="Ams2ChEd.Business.AMS2.UI.PrerequisiteSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Before you race..."
        Height="430" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#c41e3a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d32f2f"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="BEFORE YOU RACE"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Foreground="#cccccc" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15">
                To let Rewind GP automatically set up your races and overlay controls on top of the
                game, two things need to be configured in AMS2 first:
            </TextBlock>
            <TextBlock Foreground="White" FontSize="14" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8">
                1) Set Telemetry Output to "Project Cars 2"
            </TextBlock>
            <TextBlock Foreground="#cccccc" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15">
                In AMS2's Options &gt; Controls (or Gameplay) menu, set the UDP/Telemetry output
                format to "Project Cars 2" so Rewind GP can read live session data.
            </TextBlock>
            <TextBlock Foreground="White" FontSize="14" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8">
                2) Enable Borderless Window mode
            </TextBlock>
            <TextBlock Foreground="#cccccc" FontSize="13" TextWrapping="Wrap">
                In AMS2's Options &gt; Video menu, set the display mode to "Borderless Window" so
                Rewind GP's overlay can appear on top of the game.
            </TextBlock>
        </StackPanel>

        <CheckBox x:Name="DontShowAgainCheckBox"
                  Grid.Row="2"
                  Content="Don't show this again"
                  Foreground="#cccccc"
                  FontSize="13"
                  Margin="0,15,0,10"/>

        <Button Grid.Row="3"
                Content="GOT IT"
                Width="150"
                HorizontalAlignment="Center"
                Style="{StaticResource MenuButtonStyle}"
                Click="OkButton_Click"/>
    </Grid>
</Window>
