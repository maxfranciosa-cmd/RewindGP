<Window x:Class="Ams2ChEd.Business.AMS2.UI.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ams2ChEd.Business.AMS2.Localization"
        Title="{loc:Loc OptionsWindow_Title}"
        Height="600" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Charcoal.BackgroundBrush}"
        ResizeMode="NoResize">

    <!-- A utility window: it wears the charcoal look whatever the visual style. The "Charcoal.*" resources
         are not defined in this project: the host application provides them in its application resources
         (Themes/Charcoal/Base.xaml, merged by its App.xaml). -->
    <Window.Resources>
        <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource Charcoal.ComboBoxStyle}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="400"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Charcoal.TitleBarStyle}">
            <TextBlock Text="{loc:Loc OptionsWindow_HeaderText}" Style="{StaticResource Charcoal.TitleTextStyle}"/>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Style="{StaticResource Charcoal.PanelStyle}" Margin="0,14,0,0">
            <StackPanel>
                <!-- AMS2 Folder Section -->
                <Label Content="{loc:Loc OptionsWindow_Ams2FolderLabel}" Style="{StaticResource Charcoal.FieldLabelStyle}"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AMS2FolderTextBox"
                             Grid.Column="0"
                             Style="{StaticResource Charcoal.TextBoxStyle}"/>
                    <Button Grid.Column="1"
                            Content="{loc:Loc OptionsWindow_BrowseButton}"
                            Style="{StaticResource Charcoal.DialogSecondaryButtonStyle}"
                            FontSize="16"
                            Padding="18,0"
                            MinWidth="100"
                            Height="35"
                            Margin="2,0,0,0"
                            Click="BrowseButton_Click"/>
                </Grid>

                <Label Content="{loc:Loc OptionsWindow_InGamePlayerNameLabel}" Style="{StaticResource Charcoal.FieldLabelStyle}"/>
                <TextBox x:Name="AMS2PlayerNameTextBox"
                         Style="{StaticResource Charcoal.TextBoxStyle}"
                         Margin="0,0,0,18"/>

                <!-- Race Length Section -->
                <Label Content="{loc:Loc OptionsWindow_RaceLengthLabel}" Style="{StaticResource Charcoal.FieldLabelStyle}"/>
                <ComboBox x:Name="RaceLengthComboBox"
                          Style="{StaticResource FieldComboBox}"
                          Margin="0,0,0,18">
                    <ComboBoxItem Content="{loc:Loc OptionsWindow_RaceLength_Default}" Tag="Default"/>
                    <ComboBoxItem Content="{loc:Loc OptionsWindow_RaceLength_OneThird}" Tag="OneThird"/>
                    <ComboBoxItem Content="{loc:Loc OptionsWindow_RaceLength_Half}" Tag="Half"/>
                    <ComboBoxItem Content="{loc:Loc OptionsWindow_RaceLength_Full}" Tag="Full"/>
                </ComboBox>

                <!-- Language and visual style, side by side: both take effect at the next launch -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="{loc:Loc OptionsWindow_LanguageLabel}" Style="{StaticResource Charcoal.FieldLabelStyle}"/>
                        <!-- Language names are shown in their own language, not translated - standard
                             convention, and avoids a resx round-trip just to list languages. -->
                        <ComboBox x:Name="LanguageComboBox" Style="{StaticResource Charcoal.ComboBoxStyle}">
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Italiano" Tag="it"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- the tags are the AppStyle names -->
                    <StackPanel Grid.Column="2">
                        <Label Content="{loc:Loc OptionsWindow_StyleLabel}" Style="{StaticResource Charcoal.FieldLabelStyle}"/>
                        <ComboBox x:Name="StyleComboBox" Style="{StaticResource Charcoal.ComboBoxStyle}">
                            <ComboBoxItem Content="{loc:Loc OptionsWindow_Style_Retro}" Tag="Retro"/>
                            <ComboBoxItem Content="{loc:Loc OptionsWindow_Style_Charcoal}" Tag="Charcoal"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Auto-Launch Section -->
                <CheckBox x:Name="AutoLaunchCheckBox"
                          Content="{loc:Loc OptionsWindow_AutoLaunchLabel}"
                          Style="{StaticResource Charcoal.CheckBoxStyle}"
                          HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Buttons: restoring the game files stands apart from saving and closing -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="{loc:Loc OptionsWindow_RestoreVehicleFilesButton}"
                    Style="{StaticResource Charcoal.DialogSecondaryButtonStyle}"
                    FontSize="16"
                    HorizontalAlignment="Left"
                    Click="RestoreVehicleFilesButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc OptionsWindow_SaveButton}"
                        Style="{StaticResource Charcoal.DialogPrimaryButtonStyle}"
                        Click="SaveButton_Click"/>
                <Button Content="{loc:Loc OptionsWindow_CloseButton}"
                        Style="{StaticResource Charcoal.DialogSecondaryButtonStyle}"
                        Margin="2,0,0,0"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
