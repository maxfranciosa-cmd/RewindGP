<Window x:Class="Ams2ChEd.Business.AMS2.UI.RaceSetupOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rewind GP"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="OverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#c41e3a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#d32f2f"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LinkTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#1a1a1a" BorderBrush="#c41e3a" BorderThickness="3"
                CornerRadius="8" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="600">
            <StackPanel>
                <!-- Prompt state -->
                <StackPanel x:Name="PromptPanel">
                    <TextBlock Text="Go to SINGLE RACE, then click below to set up the race automatically."
                               Foreground="White" FontSize="20" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,25"/>
                    <Button x:Name="ConfigureButton" Content="SET UP RACE AUTOMATICALLY"
                            Style="{StaticResource OverlayButtonStyle}" HorizontalAlignment="Center"
                            Click="ConfigureButton_Click"/>
                    <TextBlock x:Name="SkipLink" Text="Skip — I'll set it up manually"
                               Style="{StaticResource LinkTextStyle}"
                               MouseLeftButtonUp="SkipLink_MouseLeftButtonUp"/>
                </StackPanel>

                <!-- Waiting state -->
                <StackPanel x:Name="WaitingPanel" Visibility="Collapsed">
                    <TextBlock Text="Please wait — applying race settings..."
                               Foreground="White" FontSize="20" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Auto-configure success state -->
                <StackPanel x:Name="SuccessPanel" Visibility="Collapsed">
                    <TextBlock Text="Race set up automatically! You can still change the circuit, qualifying/race session duration, or any other settings before you start, if you'd like."
                               Foreground="White" FontSize="20" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,25"/>
                    <Button x:Name="SuccessOkButton" Content="OK, GOT IT"
                            Style="{StaticResource OverlayButtonStyle}" HorizontalAlignment="Center"
                            Click="SuccessOkButton_Click"/>
                </StackPanel>

                <!-- Error state -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               Foreground="White" FontSize="16"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,25"/>
                    <Button x:Name="ContinueManuallyButton" Content="CONTINUE MANUALLY"
                            Style="{StaticResource OverlayButtonStyle}" HorizontalAlignment="Center"
                            Click="ContinueManuallyButton_Click"/>
                </StackPanel>

                <!-- Manual setup instructions state -->
                <StackPanel x:Name="ManualInstructionsPanel" Visibility="Collapsed" MaxWidth="480">
                    <TextBlock x:Name="ManualInstructionsTitle"
                               Text="SET UP MANUALLY"
                               Foreground="#c41e3a" FontSize="22" FontWeight="Bold"
                               TextAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Foreground="#e0e0e0" FontSize="13" TextWrapping="Wrap"
                               LineHeight="20" TextAlignment="Left">
                        <Run x:Name="ManualStep1" Text=""/>
                        <LineBreak/><LineBreak/>
                        <Run x:Name="ManualStep2" Text=""/>
                        <LineBreak/><LineBreak/>
                        <Run x:Name="ManualStep3" Text=""/>
                        <LineBreak/><LineBreak/>
                        <Run x:Name="ManualStep4" Text=""/>
                    </TextBlock>
                    <Button x:Name="ManualInstructionsOkButton" Content="GOT IT"
                            Style="{StaticResource OverlayButtonStyle}" HorizontalAlignment="Center"
                            Margin="0,25,0,0"
                            Click="ManualInstructionsOkButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
