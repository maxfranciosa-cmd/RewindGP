  <data name="RaceSetupOverlayWindow_SuccessText" xml:space="preserve">
    <value>Gara configurata automaticamente! Puoi comunque cambiare il circuito, la durata delle sessioni di qualifica/gara, o qualsiasi altra impostazione prima di iniziare, se lo desideri.</value>
  </data>
  <data name="RaceSetupOverlayWindow_SuccessOkButton" xml:space="preserve">
