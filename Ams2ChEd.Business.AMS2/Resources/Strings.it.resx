  <!-- RaceSetupOverlayWindow -->
  <data name="RaceSetupOverlayWindow_PromptText" xml:space="preserve">
    <value>Vai su GARA SINGOLA, poi clicca qui sotto per configurare la gara automaticamente.</value>
  </data>
  <data name="RaceSetupOverlayWindow_ConfigureButton" xml:space="preserve">
